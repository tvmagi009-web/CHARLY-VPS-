            3) if [[ -x /usr/local/bin/slipgate ]]; then /usr/local/bin/slipgate users; else echo "SlipGate no está instalado."; fi ;;
            4) if [[ -x /usr/local/bin/slipgate ]]; then /usr/local/bin/slipgate diag; else echo "SlipGate no está instalado."; fi ;;
            5) if [[ -x /usr/local/bin/slipgate ]]; then /usr/local/bin/slipgate tunnel logs; else echo "SlipGate no está instalado."; fi ;;
            6) if [[ -x /usr/local/bin/slipgate ]]; then /usr/local/bin/slipgate restart; else echo "SlipGate no está instalado."; fi ;;
            7) if [[ -x /usr/local/bin/slipgate ]]; then /usr/local/bin/slipgate backup; else echo "SlipGate no está instalado."; fi ;;
            8) if [[ -x /usr/local/bin/slipgate ]]; then read -r -p "¿Actualizar SlipGate? [s/N]: " a; [[ "$a" =~ ^[sS]$ ]] && /usr/local/bin/slipgate update; else echo "SlipGate no está instalado."; fi ;;
            9) if [[ -x /usr/local/bin/slipgate ]]; then
                   echo "ATENCIÓN: esto desinstala los componentes gestionados por SlipGate."
                   read -r -p "Escribe DESINSTALAR para confirmar: " a
                   [[ "$a" == "DESINSTALAR" ]] && /usr/local/bin/slipgate uninstall
               else echo "SlipGate no está instalado."; fi ;;
            0) return ;;
            *) echo "Opción incorrecta." ;;
        esac
        echo
        read -r -p "Presiona Enter para continuar..."
    done
}
