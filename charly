#!/bin/bash

R='\033[1;31m'
G='\033[1;32m'
Y='\033[1;33m'
B='\033[1;34m'
C='\033[1;36m'
M='\033[1;35m'
W='\033[1;37m'
N='\033[0m'
source /etc/CHARLY/modules/charly-id.sh 2>/dev/null || true

# Permitir que Dropbear autentique usuarios CHARLY con shell /bin/false.
# Esto no habilita una terminal interactiva ni modifica cuentas existentes.
if [[ "$EUID" -eq 0 ]] && [[ -x /bin/false ]] && [[ -f /etc/shells ]]; then
    if ! grep -qxF '/bin/false' /etc/shells; then
        printf '%s\\n' '/bin/false' >> /etc/shells || {
            echo "ERROR: no se pudo agregar /bin/false a /etc/shells." >&2
        }
    fi
fi

linea() {
    echo -e "${M}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${N}"
}



nuevo_usuario_ssh() {
    local db="/etc/CHARLY/config/ssh_users.db"
    local u pass fecha limite vencimiento dias n
    mkdir -p /etc/CHARLY/config
    touch "$db"
    chmod 600 "$db"

    while true; do
        clear
        linea
        echo -e "                 ${W}CREAR 👤 NUEVO USUARIO SSH${N}"
        linea
        printf " ${C}%-3s %-14s %-14s %-12s %-8s %-8s${N}\n" "#" "Usuario" "Contraseña" "Fecha" "Día Lim" "CNX/LIM"

        n=0
        while IFS=$'\t' read -r u pass fecha limite || [[ -n "$u" ]]; do
            [[ -z "$u" ]] && continue
            id "$u" >/dev/null 2>&1 || continue
            vencimiento=$(date -d "$fecha" +%d/%m/%y 2>/dev/null)
            dias=$(( ($(date -d "$fecha" +%s) - $(date +%s)) / 86400 ))
            (( dias < 0 )) && dias=0
            [[ -n "$limite" ]] || limite="—"
            ((n++))
            printf " ${G}%-3s${N} %-14s %-14s %-12s %-8s %-8s\n" "$n." "$u" "$pass" "$vencimiento" "$dias" "$limite"
        done < "$db"

        (( n == 0 )) && echo -e " ${G}No hay usuarios registrados en CHARLY todavía.${N}"
        echo
        echo -e " ${R}[0]${N}   VOLVER"
        linea
        echo

        read -r -p "Nombre Del Nuevo Usuario: " usuario
        [[ "$usuario" == "0" ]] && return

        if [[ ! "$usuario" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]; then
            echo -e "${R}Nombre inválido. Usa minúsculas, números, guion o guion bajo.${N}"
            sleep 2
            continue
        fi

        if id "$usuario" >/dev/null 2>&1; then
            echo -e "${R}Ese usuario ya existe en el VPS.${N}"
            sleep 2
            continue
        fi

        read -r -s -p "Contraseña Del Nuevo Usuario: " clave
        echo
        if [[ -z "$clave" || "$clave" == *:* || "$clave" == *$'\n'* ]]; then
            echo -e "${R}Contraseña inválida.${N}"
            sleep 2
            continue
        fi

        read -r -p "Tiempo De Duración (días): " duracion
        if [[ ! "$duracion" =~ ^[1-9][0-9]{0,3}$ ]]; then
            echo -e "${R}Duración inválida. Usa entre 1 y 9999 días.${N}"
            sleep 2
            continue
        fi

        read -r -p "Límite de conexiones simultáneas (1-100): " limite
        if [[ ! "$limite" =~ ^([1-9]|[1-9][0-9]|100)$ ]]; then
            echo -e "${R}Límite inválido. Debe ser un número entre 1 y 100.${N}"
            sleep 2
            continue
        fi

        fecha=$(date -d "+${duracion} days" +%F) || {
            echo -e "${R}No se pudo calcular el vencimiento.${N}"
            sleep 2
            continue
        }

        if ! useradd -m -s /bin/false "$usuario"; then
            echo -e "${R}No se pudo crear la cuenta Linux.${N}"
            sleep 2
            continue
        fi

        if ! printf '%s:%s\n' "$usuario" "$clave" | chpasswd; then
            userdel -r "$usuario" 2>/dev/null
            echo -e "${R}No se pudo establecer la contraseña.${N}"
            sleep 2
            continue
        fi

        if ! chage -E "$fecha" "$usuario"; then
            userdel -r "$usuario" 2>/dev/null
            echo -e "${R}No se pudo establecer el vencimiento.${N}"
            sleep 2
            continue
        fi

        printf '%s\t%s\t%s\t%s\n' "$usuario" "$clave" "$fecha" "$limite" >> "$db"
        chmod 600 "$db"

        echo
        echo -e "${G}¡USUARIO SSH CREADO CORRECTAMENTE!${N}"
        echo -e "Usuario: ${C}$usuario${N}"
        echo -e "Vencimiento: ${C}$fecha${N}"
        echo -e "Duración: ${C}$duracion días${N}"
        echo -e "Límite de conexiones: ${C}$limite${N}"
        echo
        read -r -p "Presiona ENTER para continuar..."
        return
    done
}

remover_usuario_ssh() {
    local db="/etc/CHARLY/config/ssh_users.db"
    local u pass fecha n seleccion usuario respuesta tmp

    while true; do
        clear
        linea
        echo -e "                 ${W}REMOVER USUARIO 🗑️${N}"
        linea
        printf " ${C}%-3s %-14s %-14s %-12s %-8s${N}\n" "#" "Usuario" "Contraseña" "Fecha" "Día Lim"

        local -a usuarios=()

        if [[ -f "$db" ]]; then
            while IFS=$'\t' read -r u pass fecha; do
                [[ -z "$u" ]] && continue
                id "$u" >/dev/null 2>&1 || continue
                usuarios+=("$u")
                n=${#usuarios[@]}
                local vencimiento dias
                vencimiento=$(date -d "$fecha" +%d/%m/%y 2>/dev/null)
                dias=$(( ($(date -d "$fecha" +%s) - $(date +%s)) / 86400 ))
                (( dias < 0 )) && dias=0
                printf " ${G}%-3s${N} %-14s %-14s %-12s %-8s\n" "$n." "$u" "$pass" "$vencimiento" "$dias"
            done < "$db"
        fi

        (( ${#usuarios[@]} == 0 )) && echo -e " ${Y}No hay usuarios registrados en CHARLY.${N}"

        echo
        echo -e " ${R}[0]${N}   VOLVER"
        linea
        echo
        read -r -p " [Seleccione una opción] ➜ " seleccion

        [[ "$seleccion" == "0" ]] && return

        if [[ ! "$seleccion" =~ ^[0-9]+$ ]] ||
           (( seleccion < 1 || seleccion > ${#usuarios[@]} )); then
            echo -e "${R}Selección inválida.${N}"
            sleep 2
            continue
        fi

        usuario="${usuarios[$((seleccion-1))]}"

        echo
        echo -e "${Y}Usuario seleccionado: ${C}$usuario${N}"
        read -r -p "¿Confirmas eliminar este usuario? (S/N): " respuesta

        if [[ ! "$respuesta" =~ ^[Ss]$ ]]; then
            echo -e "${Y}Eliminación cancelada.${N}"
            sleep 2
            continue
        fi

        if ! userdel -r -- "$usuario"; then
            echo -e "${R}No se pudo eliminar la cuenta Linux. Registro conservado.${N}"
            sleep 3
            continue
        fi

        tmp=$(mktemp) || {
            echo -e "${R}No se pudo actualizar la base de datos.${N}"
            sleep 3
            return
        }

        awk -F '\t' -v u="$usuario" '$1 != u' "$db" > "$tmp"
        chmod 600 "$tmp"
        mv "$tmp" "$db"

        echo -e "${G}Usuario $usuario eliminado correctamente.${N}"
        read -r -p "Presiona ENTER para continuar..."
        return
    done
}


renovar_usuario_ssh() {
    local db="/etc/CHARLY/config/ssh_users.db"
    local usuario seleccion dias fecha base nueva_fecha tmp
    local -a usuarios=()

    while true; do
        clear
        linea
        echo -e "              ${W}RENOVAR USUARIO SSH${N}"
        linea
        echo
        printf " ${W}%-4s %-14s %-14s %-12s %-8s${N}\n" "#" "Usuario" "Contraseña" "Vence" "Días"
        linea

        usuarios=()

        if [[ -f "$db" ]]; then
            while IFS=$'\t' read -r u pass fecha || [[ -n "$u" ]]; do
                [[ -n "$u" ]] || continue
                id "$u" >/dev/null 2>&1 || continue

                usuarios+=("$u")
                vencimiento=$(date -d "$fecha" +%d/%m/%y 2>/dev/null || echo "$fecha")
                dias_restantes=$(( ($(date -d "$fecha" +%s 2>/dev/null || echo 0) - $(date +%s)) / 86400 ))
                (( dias_restantes < 0 )) && dias_restantes=0

                printf " ${G}%-4s${N} %-14s %-14s %-12s %-8s\n" \
                    "${#usuarios[@]}." "$u" "$pass" "$vencimiento" "$dias_restantes"
            done < "$db"
        fi

        (( ${#usuarios[@]} == 0 )) && echo -e " ${Y}No hay usuarios registrados en CHARLY.${N}"

        echo
        echo -e " ${R}[0]${N}   VOLVER"
        linea
        echo
        read -r -p " [Seleccione un usuario] ➜ " seleccion

        [[ "$seleccion" == "0" ]] && return

        if [[ ! "$seleccion" =~ ^[0-9]+$ ]] ||
           (( seleccion < 1 || seleccion > ${#usuarios[@]} )); then
            echo -e "${R}Selección inválida.${N}"
            sleep 2
            continue
        fi

        usuario="${usuarios[$((seleccion-1))]}"

        echo
        echo -e "${C}Usuario seleccionado: ${G}$usuario${N}"
        read -r -p "¿Cuántos días deseas agregar?: " dias

        if [[ ! "$dias" =~ ^[0-9]+$ ]] || (( dias < 1 || dias > 9999 )); then
            echo -e "${R}Cantidad de días inválida.${N}"
            sleep 2
            continue
        fi

        fecha=$(awk -F '\t' -v u="$usuario" '$1 == u {print $3; exit}' "$db")
        base=$(date -d "$fecha" +%F 2>/dev/null || date +%F)

        if [[ "$base" < "$(date +%F)" ]]; then
            base=$(date +%F)
        fi

        nueva_fecha=$(date -d "$base + $dias days" +%F) || {
            echo -e "${R}No se pudo calcular la nueva fecha.${N}"
            sleep 2
            continue
        }

        echo
        echo -e "${Y}Nueva fecha de vencimiento: ${G}$nueva_fecha${N}"
        read -r -p "¿Confirmas la renovación? (S/N): " respuesta

        if [[ ! "$respuesta" =~ ^[Ss]$ ]]; then
            echo -e "${Y}Renovación cancelada.${N}"
            sleep 2
            continue
        fi

        if ! chage -E "$nueva_fecha" "$usuario"; then
            echo -e "${R}No se pudo actualizar la cuenta Linux.${N}"
            sleep 3
            continue
        fi

        tmp=$(mktemp) || {
            echo -e "${R}No se pudo actualizar la base de datos.${N}"
            sleep 3
            return
        }

        awk -F '\t' -v OFS='\t' -v u="$usuario" -v f="$nueva_fecha" \
            '$1 == u {$3=f} {print}' "$db" > "$tmp"

        chmod 600 "$tmp"
        mv "$tmp" "$db"

        echo -e "${G}Usuario $usuario renovado correctamente.${N}"
        echo -e "${G}Nueva fecha: $nueva_fecha${N}"
        read -r -p "Presiona ENTER para continuar..."
        return
    done
}


editar_usuario_ssh() {
    local db="/etc/CHARLY/config/ssh_users.db"
    local usuario seleccion nueva_clave tmp
    local u pass fecha vencimiento dias
    local -a usuarios=()

    while true; do
        clear
        linea
        echo -e "                 ${W}EDITAR USUARIO${N}"
        linea
        echo -e " ${W}#    Usuario        Contraseña     Fecha        Días${N}"
        linea

        usuarios=()

        if [[ -f "$db" ]]; then
            while IFS=$'\t' read -r u pass fecha || [[ -n "$u" ]]; do
                [[ -n "$u" ]] || continue
                id "$u" >/dev/null 2>&1 || continue

                usuarios+=("$u")
                vencimiento=$(date -d "$fecha" +%d/%m/%y 2>/dev/null || echo "$fecha")
                dias=$(( ($(date -d "$fecha" +%s 2>/dev/null || echo 0) - $(date +%s)) / 86400 ))
                (( dias < 0 )) && dias=0

                printf " ${G}%-4s${N} %-14s %-14s %-12s %-8s\n" \
                    "${#usuarios[@]}." "$u" "$pass" "$vencimiento" "$dias"
            done < "$db"
        fi

        (( ${#usuarios[@]} == 0 )) && echo -e " ${Y}No hay usuarios registrados en CHARLY.${N}"

        echo
        echo -e " ${R}[0]${N}   VOLVER"
        linea
        echo
        read -r -p " [Seleccione una opción] ➜ " seleccion

        [[ "$seleccion" == "0" ]] && return

        if [[ ! "$seleccion" =~ ^[0-9]+$ ]] ||
           (( seleccion < 1 || seleccion > ${#usuarios[@]} )); then
            echo -e "${R}Selección inválida.${N}"
            sleep 2
            continue
        fi

        usuario="${usuarios[$((seleccion-1))]}"

        echo
        read -r -p " Nueva Contraseña de $usuario: " nueva_clave

        if [[ -z "$nueva_clave" || "$nueva_clave" == *:* ||
              "$nueva_clave" == *$'\t'* || "$nueva_clave" == *$'\n'* ]]; then
            echo -e "${R}Contraseña inválida.${N}"
            sleep 2
            continue
        fi

        tmp=$(mktemp) || {
            echo -e "${R}No se pudo preparar la actualización.${N}"
            sleep 2
            return
        }

        if ! awk -F '\t' -v OFS='\t' -v u="$usuario" -v clave="$nueva_clave" \
            '$1 == u {$2=clave; encontrado=1} {print} END {if (!encontrado) exit 1}' \
            "$db" > "$tmp"; then
            rm -f "$tmp"
            echo -e "${R}No se encontró el usuario en CHARLY.${N}"
            sleep 2
            continue
        fi

        if ! printf '%s:%s\n' "$usuario" "$nueva_clave" | chpasswd; then
            rm -f "$tmp"
            echo -e "${R}No se pudo cambiar la contraseña en Linux.${N}"
            sleep 3
            continue
        fi

        chmod 600 "$tmp"
        mv "$tmp" "$db"

        echo
        echo -e "${G}Contraseña de $usuario actualizada correctamente.${N}"
        read -r -p "Presiona ENTER para continuar..."
        return
    done
}


bloquear_usuario_ssh() {
    local db="/etc/CHARLY/config/ssh_users.db"
    local usuario seleccion accion estado respuesta
    local u pass fecha
    local -a usuarios=()

    while true; do
        clear
        linea
        echo -e "          ${W}BLOQUEAR / DESBLOQUEAR USUARIO${N}"
        linea
        echo
        printf " ${W}%-4s %-14s %-14s %-12s %-12s${N}\n" "#" "Usuario" "Contraseña" "Vence" "Estado"
        linea

        usuarios=()

        if [[ -f "$db" ]]; then
            while IFS=$'\t' read -r u pass fecha || [[ -n "$u" ]]; do
                [[ -n "$u" ]] || continue
                id "$u" >/dev/null 2>&1 || continue

                usuarios+=("$u")
                estado=$(passwd -S "$u" 2>/dev/null | awk '{print $2}')
                if [[ "$estado" == "L" ]]; then
                    estado="${R}BLOQUEADO${N}"
                else
                    estado="${G}ACTIVO${N}"
                fi

                vencimiento=$(date -d "$fecha" +%d/%m/%y 2>/dev/null || echo "$fecha")
                printf " ${G}%-4s${N} %-14s %-14s %-12s " \
                    "${#usuarios[@]}." "$u" "$pass" "$vencimiento"
                echo -e "$estado"
            done < "$db"
        fi

        (( ${#usuarios[@]} == 0 )) && echo -e " ${Y}No hay usuarios registrados en CHARLY.${N}"

        echo
        echo -e " ${R}[0]${N}   VOLVER"
        linea
        echo
        read -r -p " [Seleccione un usuario] ➜ " seleccion

        [[ "$seleccion" == "0" ]] && return

        if [[ ! "$seleccion" =~ ^[0-9]+$ ]] ||
           (( seleccion < 1 || seleccion > ${#usuarios[@]} )); then
            echo -e "${R}Selección inválida.${N}"
            sleep 2
            continue
        fi

        usuario="${usuarios[$((seleccion-1))]}"
        estado=$(passwd -S "$usuario" 2>/dev/null | awk '{print $2}')

        echo
        echo -e "Usuario seleccionado: ${C}$usuario${N}"
        if [[ "$estado" == "L" ]]; then
            echo -e "Estado actual: ${R}BLOQUEADO${N}"
            accion="desbloquear"
        else
            echo -e "Estado actual: ${G}ACTIVO${N}"
            accion="bloquear"
        fi

        echo
        read -r -p "¿Deseas $accion este usuario? (S/N): " respuesta

        if [[ ! "$respuesta" =~ ^[Ss]$ ]]; then
            echo -e "${Y}Operación cancelada.${N}"
            sleep 2
            continue
        fi

        if [[ "$accion" == "bloquear" ]]; then
            passwd -l "$usuario" || {
                echo -e "${R}No se pudo bloquear el usuario.${N}"
                sleep 3
                continue
            }
            echo -e "${G}Usuario $usuario BLOQUEADO correctamente.${N}"
        else
            passwd -u "$usuario" || {
                echo -e "${R}No se pudo desbloquear el usuario.${N}"
                sleep 3
                continue
            }
            echo -e "${G}Usuario $usuario DESBLOQUEADO correctamente.${N}"
        fi

        read -r -p "Presiona ENTER para continuar..."
        return
    done
}


detalles_usuarios_ssh() {
    local db="/etc/CHARLY/config/ssh_users.db"
    local u pass fecha vencimiento dias estado hoy
    hoy=$(date +%F)

    while true; do
        clear
        linea
        echo -e "                 ${W}DETALLES DE USUARIOS SSH${N}"
        linea
        echo
        printf " ${W}%-4s %-14s %-14s %-12s %-8s %-12s${N}\n" \
            "#" "Usuario" "Contraseña" "Vence" "Días" "Estado"
        linea

        if [[ -f "$db" ]]; then
            local n=0
            while IFS=$'\t' read -r u pass fecha || [[ -n "$u" ]]; do
                [[ -n "$u" ]] || continue
                ((n++))

                vencimiento=$(date -d "$fecha" +%d/%m/%Y 2>/dev/null || echo "$fecha")

                if ! id "$u" >/dev/null 2>&1; then
                    dias="-"
                    estado="${R}NO EXISTE${N}"
                elif [[ "$fecha" < "$hoy" ]]; then
                    dias=0
                    estado="${R}VENCIDO${N}"
                else
                    dias=$(( ($(date -d "$fecha" +%s) - $(date +%s)) / 86400 ))
                    cuenta_estado=$(passwd -S "$u" 2>/dev/null | awk '{print $2}')
                    if [[ "$cuenta_estado" == "L" ]]; then
                        estado="${R}BLOQUEADO${N}"
                    else
                        estado="${G}ACTIVO${N}"
                    fi
                fi

                printf " ${G}%-4s${N} %-14s %-14s %-12s %-8s " \
                    "$n." "$u" "$pass" "$vencimiento" "$dias"
                echo -e "$estado"
            done < "$db"

            (( n == 0 )) && echo -e " ${Y}No hay usuarios registrados.${N}"
        else
            echo -e " ${Y}No existe la base de datos de usuarios.${N}"
        fi

        echo
        linea
        echo -e " ${R}[0]${N}  VOLVER"
        linea
        echo
        read -r -p " Presiona ENTER para volver..."
        return
    done
}


monitor_usuarios_ssh() {
    local db="/etc/CHARLY/config/ssh_users.db"
    local u pass fecha limite datos conexiones segundos tiempo estado tecla

    while true; do
        clear
        linea
        echo -e "                  ${W}MONITOR DE USUARIOS SSH${N}"
        linea
        echo
        printf " ${W}%-14s %-10s %-9s %-12s %-8s %-10s${N}\n" \
            "USUARIO" "ESTADO" "CNX/LIM" "TIEMPO" "VEL" "CONSUMO"
        linea

        if [[ -f "$db" ]]; then
            while IFS=$'\t' read -r u pass fecha limite || [[ -n "$u" ]]; do
                [[ -n "$u" ]] || continue

                datos=$(ps -eo user,pid,etimes,args | awk -v u="$u" '
                    $1 == u && $4 == "sshd:" &&
                    index($5,u) == 1 &&
                    (length($5) == length(u) ||
                     substr($5,length(u)+1,1) == "@") {
                        n++
                        if ($3 > max) max=$3
                    }
                    END { printf "%d %d", n, max }
                ')

                read -r conexiones segundos <<< "$datos"
                segundos=${segundos:-0}

                if (( conexiones > 0 )); then
                    estado="${G}ONLINE${N}"
                    printf -v tiempo '%02d:%02d:%02d' \
                        "$((segundos/3600))" "$(((segundos%3600)/60))" "$((segundos%60))"
                else
                    estado="${R}OFFLINE${N}"
                    tiempo="--"
                fi

                [[ -n "$limite" ]] || limite="—"

                printf " %-14s " "$u"
                echo -ne "$estado"
                printf "%*s%-9s %-12s %-8s %-10s\n" \
                    "$((10-${#estado}+${#estado}-10))" "" \
                    "${conexiones}/${limite}" "$tiempo" "--" "--"
            done < "$db"
        else
            echo -e " ${Y}No existe la base de datos.${N}"
        fi

        echo
        linea
        echo -e " ${Y}Actualización automática cada 3 segundos${N}"
        echo -e " ${R}[Q]${N} Salir del monitor"
        linea

        tecla=""
        read -r -t 3 -p " ➜ " tecla || true
        [[ "${tecla,,}" == "q" ]] && return
    done
}

menu_ssh() {
    while true; do
        clear
        linea
        echo -e "             ${W}ADMINISTRACIÓN DE USUARIOS SSH${N}"
        linea
        echo
        echo -e " ${G}[01]${N}  👤 NUEVO USUARIO SSH"
        echo -e " ${R}[02]${N}  🗑️ REMOVER USUARIO"
        echo -e " ${G}[03]${N}  🔄 RENOVAR USUARIO"
        echo -e " ${C}[04]${N}  ✏️ EDITAR USUARIO"
        echo -e " ${C}[05]${N}  🔒 BLOQ/DESBLOQ USUARIO"
        echo -e " ${C}[06]${N}  📋 DETALLES DE USUARIOS"
        echo -e " ${C}[07]${N}  📊 MONITOR DE USUARIOS"
        echo
        linea
        echo -e " ${R}[00]${N}  VOLVER AL MENÚ PRINCIPAL"
        linea
        echo
        echo -e "${G}Seleccione una opción:${N}"
        read -r -p " ➜ " op

        case "$op" in
            0|00) return ;;
            1|01) nuevo_usuario_ssh ;;
            2|02) remover_usuario_ssh ;;
            3|03) renovar_usuario_ssh ;;
            4|04) editar_usuario_ssh ;;
            5|05) bloquear_usuario_ssh ;;
            6|06) detalles_usuarios_ssh ;;
            7|07) monitor_usuarios_ssh ;;
            *)
                echo -e "${R}Opción incorrecta.${N}"
                sleep 1
                ;;
        esac
    done
}



modificar_puerto_ssh() {
    clear
    linea
    echo -e "             ${W}CAMBIAR PUERTO SSH${N}"
    linea

    local nuevo actual ssh_conf socket_dir socket_file backup_dir
    local socket_active confirmar p final_ports
    local -a puertos nuevos

    ssh_conf="/etc/ssh/sshd_config.d/00-charly-port.conf"
    socket_dir="/etc/systemd/system/ssh.socket.d"
    socket_file="$socket_dir/charly.conf"

    if ! command -v sshd >/dev/null 2>&1; then
        echo -e "${R}OpenSSH no está instalado.${N}"
        read -r -p "Presione Enter para continuar..."
        return
    fi

    socket_active=0
    systemctl is-active --quiet ssh.socket && socket_active=1

    if (( socket_active )); then
        mapfile -t puertos < <(
            systemctl show ssh.socket -p Listen |
            sed -nE 's/.*:([0-9]+) \(Stream\).*/\1/p' |
            sort -nu
        )
    else
        mapfile -t puertos < <(
            sshd -T 2>/dev/null |
            awk '$1=="port"{print $2}' |
            sort -nu
        )
    fi

    if (( ${#puertos[@]} == 0 )); then
        puertos=(22)
    fi

    actual="${puertos[0]}"

    echo -e " Puertos actuales: ${G}${puertos[*]}${N}"
    echo
    read -r -p " Introduzca el nuevo puerto: " nuevo

    if ! [[ "$nuevo" =~ ^[0-9]+$ ]] || (( nuevo < 1 || nuevo > 65535 )); then
        echo -e "${R}Puerto inválido.${N}"
        read -r -p "Presione Enter para continuar..."
        return
    fi

    if [[ " ${puertos[*]} " == *" $nuevo "* ]]; then
        echo -e "${Y}Ese puerto ya está configurado.${N}"
        read -r -p "Presione Enter para continuar..."
        return
    fi

    if ss -H -lnt | awk -v p="$nuevo" '{
        n=split($4,a,":")
        if(a[n]==p) f=1
    } END{exit !f}'; then
        echo -e "${R}El puerto $nuevo ya está ocupado por otro servicio.${N}"
        read -r -p "Presione Enter para continuar..."
        return
    fi

    backup_dir="/etc/CHARLY/backups/ssh-port-$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$backup_dir"

    if [[ -e "$ssh_conf" ]]; then
        cp -a "$ssh_conf" "$backup_dir/ssh-conf"
    else
        touch "$backup_dir/NO_SSH_CONF"
    fi

    if [[ -e "$socket_file" ]]; then
        cp -a "$socket_file" "$backup_dir/socket-conf"
    else
        touch "$backup_dir/NO_SOCKET_CONF"
    fi

    restaurar_charly_ssh() {
        if [[ -f "$backup_dir/NO_SSH_CONF" ]]; then
            rm -f "$ssh_conf"
        else
            cp -a "$backup_dir/ssh-conf" "$ssh_conf"
        fi

        if [[ -f "$backup_dir/NO_SOCKET_CONF" ]]; then
            rm -f "$socket_file"
        else
            mkdir -p "$socket_dir"
            cp -a "$backup_dir/socket-conf" "$socket_file"
        fi

        systemctl daemon-reload
        if (( socket_active )); then
            systemctl restart ssh.socket
        else
            systemctl restart ssh
        fi
    }

    nuevos=("${puertos[@]}" "$nuevo")

    {
        echo "# Administrado por CHARLY VPS"
        for p in "${nuevos[@]}"; do
            echo "Port $p"
        done
    } > "$ssh_conf"

    if (( socket_active )); then
        mkdir -p "$socket_dir"
        {
            echo "[Socket]"
            echo "ListenStream="
            for p in "${nuevos[@]}"; do
                echo "ListenStream=0.0.0.0:$p"
                echo "ListenStream=[::]:$p"
            done
        } > "$socket_file"
    fi

    if ! sshd -t; then
        echo -e "${R}Configuración SSH inválida. Restaurando...${N}"
        restaurar_charly_ssh
        read -r -p "Presione Enter para continuar..."
        return
    fi

    systemctl daemon-reload
    if (( socket_active )); then
        systemctl restart ssh.socket
    else
        systemctl reload-or-restart ssh
    fi

    sleep 2

    if ! ss -H -lnt | awk -v p="$nuevo" '{
        n=split($4,a,":")
        if(a[n]==p) f=1
    } END{exit !f}'; then
        echo -e "${R}No se detectó el puerto nuevo. Restaurando configuración...${N}"
        restaurar_charly_ssh
        read -r -p "Presione Enter para continuar..."
        return
    fi

    echo
    echo -e "${G}Puerto $nuevo habilitado correctamente.${N}"
    echo -e "${Y}Los puertos anteriores siguen activos.${N}"
    echo
    echo -e "Abra una SEGUNDA conexión SSH usando el puerto ${G}$nuevo${N}."
    echo
    read -r -p "¿Pudo conectarse correctamente? [s/N]: " confirmar

    if [[ "$confirmar" =~ ^[sS]$ ]]; then
        final_ports=()
        for p in "${puertos[@]}"; do
            [[ "$p" == "$actual" ]] || final_ports+=("$p")
        done
        final_ports+=("$nuevo")

        {
            echo "# Administrado por CHARLY VPS"
            for p in "${final_ports[@]}"; do
                echo "Port $p"
            done
        } > "$ssh_conf"

        if (( socket_active )); then
            {
                echo "[Socket]"
                echo "ListenStream="
                for p in "${final_ports[@]}"; do
                    echo "ListenStream=0.0.0.0:$p"
                    echo "ListenStream=[::]:$p"
                done
            } > "$socket_file"
        fi

        if ! sshd -t; then
            echo -e "${R}Error al validar el cambio final. Restaurando...${N}"
            restaurar_charly_ssh
            read -r -p "Presione Enter para continuar..."
            return
        fi

        systemctl daemon-reload
        if (( socket_active )); then
            systemctl restart ssh.socket
        else
            systemctl reload-or-restart ssh
        fi

        sleep 2

        if ! ss -H -lnt | awk -v p="$nuevo" '{
            n=split($4,a,":")
            if(a[n]==p) f=1
        } END{exit !f}'; then
            echo -e "${R}No se confirmó el nuevo puerto. Restaurando...${N}"
            restaurar_charly_ssh
            read -r -p "Presione Enter para continuar..."
            return
        fi

        echo -e "${G}Puerto principal cambiado a $nuevo.${N}"
        echo -e "Puertos restantes: ${G}${final_ports[*]}${N}"
    else
        echo -e "${Y}Se conservaron los puertos anteriores y el nuevo.${N}"
        echo -e "No se retiró ningún puerto."
    fi

    echo
    echo -e "Respaldo: $backup_dir"
    read -r -p "Presione Enter para continuar..."
}


remover_puerto_ssh() {
    clear
    linea
    echo -e "             ${W}REMOVER PUERTO SSH${N}"
    linea

    local ssh_conf="/etc/ssh/sshd_config.d/00-charly-port.conf"
    local socket_dir="/etc/systemd/system/ssh.socket.d"
    local socket_file="$socket_dir/charly.conf"
    local backup_dir puerto elegido confirmar socket_active
    local -a puertos restantes

    mapfile -t puertos < <(sshd -T 2>/dev/null | awk '$1=="port"{print $2}' | sort -nu)

    if (( ${#puertos[@]} <= 1 )); then
        echo -e "${R}No se puede eliminar el último puerto SSH.${N}"
        read -r -p "Presione Enter para continuar..."
        return
    fi

    echo " PUERTOS SSH CONFIGURADOS:"
    echo
    for puerto in "${puertos[@]}"; do
        echo -e " ${G}[$puerto]${N}"
    done

    echo
    read -r -p "Puerto que desea eliminar: " elegido

    if ! [[ "$elegido" =~ ^[0-9]+$ ]] || [[ ! " ${puertos[*]} " == *" $elegido "* ]]; then
        echo -e "${R}Puerto no válido.${N}"
        read -r -p "Presione Enter para continuar..."
        return
    fi

    if (( ${#puertos[@]} <= 1 )); then
        echo -e "${R}No se puede eliminar el último puerto.${N}"
        read -r -p "Presione Enter para continuar..."
        return
    fi

    restantes=()
    for puerto in "${puertos[@]}"; do
        [[ "$puerto" == "$elegido" ]] || restantes+=("$puerto")
    done

    echo
    echo -e "${Y}Se eliminará el puerto $elegido.${N}"
    echo -e "Se conservarán: ${G}${restantes[*]}${N}"
    read -r -p "¿Desea continuar? [s/N]: " confirmar
    [[ "$confirmar" =~ ^[sS]$ ]] || return

    backup_dir="/etc/CHARLY/backups/ssh-remove-$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$backup_dir"

    if [[ -f "$ssh_conf" ]]; then
        cp -a "$ssh_conf" "$backup_dir/ssh-conf"
    else
        touch "$backup_dir/NO_SSH_CONF"
    fi

    if [[ -f "$socket_file" ]]; then
        cp -a "$socket_file" "$backup_dir/socket-conf"
    else
        touch "$backup_dir/NO_SOCKET_CONF"
    fi

    systemctl is-active --quiet ssh.socket && socket_active=1 || socket_active=0

    restaurar_remocion_ssh() {
        if [[ -f "$backup_dir/NO_SSH_CONF" ]]; then
            rm -f "$ssh_conf"
        else
            cp -a "$backup_dir/ssh-conf" "$ssh_conf"
        fi

        if [[ -f "$backup_dir/NO_SOCKET_CONF" ]]; then
            rm -f "$socket_file"
        else
            mkdir -p "$socket_dir"
            cp -a "$backup_dir/socket-conf" "$socket_file"
        fi

        systemctl daemon-reload
        if (( socket_active )); then
            systemctl restart ssh.socket
        else
            systemctl restart ssh
        fi
    }

    mkdir -p "$(dirname "$ssh_conf")"
    {
        echo "# Administrado por CHARLY VPS"
        for puerto in "${restantes[@]}"; do
            echo "Port $puerto"
        done
    } > "$ssh_conf"

    if (( socket_active )); then
        mkdir -p "$socket_dir"
        {
            echo "[Socket]"
            echo "ListenStream="
            for puerto in "${restantes[@]}"; do
                echo "ListenStream=0.0.0.0:$puerto"
                echo "ListenStream=[::]:$puerto"
            done
        } > "$socket_file"
    fi

    if ! sshd -t; then
        echo -e "${R}Configuración inválida. Restaurando...${N}"
        restaurar_remocion_ssh
        read -r -p "Presione Enter para continuar..."
        return
    fi

    systemctl daemon-reload
    if (( socket_active )); then
        systemctl restart ssh.socket
    else
        systemctl reload-or-restart ssh
    fi

    sleep 2

    if sshd -T 2>/dev/null | awk -v p="$elegido" '$1=="port" && $2==p{found=1} END{exit !found}'; then
        echo -e "${R}El puerto sigue configurado. Restaurando...${N}"
        restaurar_remocion_ssh
        read -r -p "Presione Enter para continuar..."
        return
    fi

    if ss -H -lnt | awk -v p="$elegido" '{n=split($4,a,":"); if(a[n]==p) f=1} END{exit !f}'; then
        echo -e "${R}El puerto todavía está escuchando. Restaurando...${N}"
        restaurar_remocion_ssh
        read -r -p "Presione Enter para continuar..."
        return
    fi

    echo
    echo -e "${G}Puerto $elegido eliminado correctamente.${N}"
    echo -e "Puertos SSH restantes: ${G}${restantes[*]}${N}"
    echo -e "Respaldo: $backup_dir"
    read -r -p "Presione Enter para continuar..."
}


iniciar_detener_ssh() {
    clear
    linea
    echo -e "             ${W}INICIAR / DETENER SSH${N}"
    linea

    if ! command -v sshd >/dev/null 2>&1; then
        echo -e "${R}OpenSSH no está instalado.${N}"
        read -r -p "Presione Enter para continuar..."
        return
    fi

    if systemctl is-active --quiet ssh.socket || systemctl is-active --quiet ssh.service; then
        echo -e " Estado actual: ${G}SSH ACTIVO${N}"
        echo
        echo -e "${Y}ATENCIÓN: al detener SSH no se aceptarán nuevas conexiones.${N}"
        read -r -p "¿Desea detener SSH? [s/N]: " confirmar

        [[ "$confirmar" =~ ^[sS]$ ]] || return

        systemctl stop ssh.socket ssh.service 2>/dev/null

        sleep 1

        if systemctl is-active --quiet ssh.socket || systemctl is-active --quiet ssh.service; then
            echo -e "${R}No se pudo detener completamente SSH.${N}"
        else
            echo -e "${G}Servidor SSH detenido.${N}"
        fi
    else
        echo -e " Estado actual: ${R}SSH DETENIDO${N}"
        echo

        if ! sshd -t; then
            echo -e "${R}La configuración SSH tiene errores. No se iniciará.${N}"
            read -r -p "Presione Enter para continuar..."
            return
        fi

        if systemctl cat ssh.socket >/dev/null 2>&1; then
            systemctl start ssh.socket
        else
            systemctl start ssh.service
        fi

        sleep 1

        if systemctl is-active --quiet ssh.socket || systemctl is-active --quiet ssh.service; then
            echo -e "${G}Servidor SSH iniciado correctamente.${N}"
        else
            echo -e "${R}No se pudo iniciar SSH. Revise systemctl status ssh.${N}"
        fi
    fi

    echo
    read -r -p "Presione Enter para continuar..."
}


reiniciar_servidor_ssh() {
    clear
    linea
    echo -e "             ${W}REINICIAR SERVIDOR SSH${N}"
    linea

    if ! command -v sshd >/dev/null 2>&1; then
        echo -e "${R}OpenSSH no está instalado.${N}"
        read -r -p "Presione Enter para continuar..."
        return
    fi

    if ! systemctl is-active --quiet ssh.socket && ! systemctl is-active --quiet ssh.service; then
        echo -e "${R}SSH está detenido. Utilice la opción 4 para iniciarlo.${N}"
        read -r -p "Presione Enter para continuar..."
        return
    fi

    if ! sshd -t; then
        echo -e "${R}Configuración SSH inválida. No se realizará el reinicio.${N}"
        read -r -p "Presione Enter para continuar..."
        return
    fi

    echo -e "${Y}Reiniciando servidor SSH...${N}"

    if systemctl is-active --quiet ssh.socket; then
        systemctl restart ssh.socket
        resultado=$?
    else
        systemctl restart ssh.service
        resultado=$?
    fi

    sleep 2

    if (( resultado == 0 )) && { systemctl is-active --quiet ssh.socket || systemctl is-active --quiet ssh.service; }; then
        echo -e "${G}Servidor SSH reiniciado correctamente.${N}"
    else
        echo -e "${R}Error al reiniciar SSH. Compruebe systemctl status ssh.${N}"
    fi

    echo
    read -r -p "Presione Enter para continuar..."
}

menu_ajustes_ssh() {
    local op puerto estado
    while true; do
        clear
        puerto=$(sshd -T 2>/dev/null | awk '$1=="port"{print $2}' | paste -sd ' ' -)
        puerto=${puerto:-NO DETECTADO}

        if systemctl is-active --quiet ssh.service || systemctl is-active --quiet ssh.socket; then
            estado="${G}[ ON ]${N}"
        else
            estado="${R}[ OFF ]${N}"
        fi

        linea
        printf "             ${W}ADMINISTRADOR SSH${N}\n"
        linea
        printf " ${C}PUERTOS ACTIVOS:${N} ${G}%s${N}\n" "$puerto"
        linea
        echo
        echo -e " ${C}[1]${N} MODIFICAR PUERTO SSH (PRINCIPAL)"
        echo -e " ${C}[2]${N} AGREGAR PUERTO(S) SSH"
        echo -e " ${C}[3]${N} REMOVER PUERTO(S) SSH"
        echo
        echo -e " ${C}[4]${N} INICIAR / DETENER SSH     $estado"
        echo -e " ${C}[5]${N} REINICIAR SERVIDOR SSH"
        linea
        echo -e " ${R}[0]${N} VOLVER AL MENU DE INSTALADORES"
        linea
        echo
        read -r -p "Seleccione una opción: " op

        case "$op" in
            1) modificar_puerto_ssh ;;
            2)
                echo -e "${Y}Esta función se implementará en el siguiente paso.${N}"
                read -r -p "Presione Enter para continuar..."
                ;;
            3) remover_puerto_ssh ;;
            4) iniciar_detener_ssh ;;
            5) reiniciar_servidor_ssh ;;
            0) return ;;
            *) echo -e "${R}Opción incorrecta.${N}"; sleep 1 ;;
        esac
    done
}

charly_dropbear_puerto_libre() {
    local puerto="$1"
    local ocupacion

    ocupacion=$(ss -H -lntp "sport = :$puerto" 2>/dev/null)

    if [[ -n "$ocupacion" ]] && grep -qv 'dropbear' <<< "$ocupacion"; then
        return 1
    fi
    return 0
}

charly_dropbear_configurar() {
    local puerto="$1"
    local temporal

    temporal=$(mktemp /etc/default/dropbear.XXXXXX) || return 1

    if [[ -f /etc/default/dropbear ]]; then
        awk '!/^[[:space:]]*(DROPBEAR_PORT|NO_START|DROPBEAR_EXTRA_ARGS)=/' \
            /etc/default/dropbear > "$temporal"
    fi

    cat >> "$temporal" <<EOFCONFIG
DROPBEAR_PORT=$puerto
NO_START=0
DROPBEAR_EXTRA_ARGS="-r /etc/dropbear/dropbear_rsa_host_key -r /etc/dropbear/dropbear_ed25519_host_key"
EOFCONFIG

    chmod 644 "$temporal"
    mv -f "$temporal" /etc/default/dropbear
}

charly_dropbear_verificar() {
    local puerto="$1"

    systemctl is-active --quiet dropbear || return 1
    ss -H -lntp "sport = :$puerto" 2>/dev/null | grep -q 'dropbear'
}

menu_dropbear() {
    local op puerto estado nuevo confirmar respaldo

    while true; do
        clear

        puerto=$(awk -F= '/^[[:space:]]*DROPBEAR_PORT=/ {
            gsub(/["'\'' ]/, "", $2)
            print $2
            exit
        }' /etc/default/dropbear 2>/dev/null)
        puerto=${puerto:-NO CONFIGURADO}

        if systemctl is-active --quiet dropbear; then
            estado="${G}ON${N}"
        else
            estado="${R}OFF${N}"
        fi

        linea
        printf "             ${W}ADMINISTRADOR DROPBEAR SSH${N}\n"
        linea
        printf " ${C}ESTADO:${N}       %b\n" "$estado"
        printf " ${C}PUERTOS:${N}      ${G}%s${N}\n" "$puerto"
        linea
        echo
        echo -e " ${C}[1]${N} Reiniciar servicio"
        echo -e " ${C}[2]${N} Configurar puerto"
        echo -e " ${C}[3]${N} Ver puertos activos"
        echo -e " ${C}[4]${N} Ver logs"
        echo -e " ${C}[5]${N} Instalar / Reinstalar"
        echo -e " ${R}[6]${N} Desinstalar Dropbear"
        linea
        echo -e " ${R}[0]${N} Volver"
        linea
        echo
        read -r -p " Opción: " op

        case "$op" in
            1)
                if ! command -v dropbear >/dev/null 2>&1; then
                    echo -e "${R}Dropbear no está instalado.${N}"
                elif systemctl restart dropbear && charly_dropbear_verificar "$puerto"; then
                    echo -e "${G}Dropbear reiniciado correctamente.${N}"
                else
                    echo -e "${R}Error: Dropbear no inició correctamente.${N}"
                    journalctl -u dropbear -n 15 --no-pager
                fi
                read -r -p "Presione Enter para continuar..."
                ;;

            2)
                read -r -p "Nuevo puerto para Dropbear: " nuevo

                if [[ ! "$nuevo" =~ ^[0-9]+$ ]] || (( nuevo < 1 || nuevo > 65535 )); then
                    echo -e "${R}Puerto inválido.${N}"
                elif ! command -v dropbear >/dev/null 2>&1; then
                    echo -e "${R}Primero instala Dropbear con la opción 5.${N}"
                elif ! charly_dropbear_puerto_libre "$nuevo"; then
                    echo -e "${R}El puerto $nuevo está ocupado por otro servicio.${N}"
                else
                    respaldo=$(mktemp) || {
                        echo -e "${R}No se pudo crear respaldo.${N}"
                        read -r -p "Presione Enter..."
                        continue
                    }

                    cp -a /etc/default/dropbear "$respaldo"

                    if charly_dropbear_configurar "$nuevo" &&
                       systemctl restart dropbear &&
                       charly_dropbear_verificar "$nuevo"; then
                        echo -e "${G}Puerto cambiado correctamente a $nuevo.${N}"
                        rm -f "$respaldo"
                    else
                        cp -a "$respaldo" /etc/default/dropbear
                        systemctl restart dropbear
                        echo -e "${R}Falló el cambio. Configuración anterior restaurada.${N}"
                        rm -f "$respaldo"
                        journalctl -u dropbear -n 15 --no-pager
                    fi
                fi
                read -r -p "Presione Enter para continuar..."
                ;;

            3)
                echo
                echo -e "${C}PUERTOS ACTIVOS DE DROPBEAR:${N}"
                ss -lntp 2>/dev/null | grep dropbear || echo "No hay puertos activos."
                echo
                read -r -p "Presione Enter para continuar..."
                ;;

            4)
                echo -e "${C}LOGS DEL ARRANQUE ACTUAL:${N}"
                journalctl -u dropbear -b -n 30 --no-pager
                echo
                read -r -p "Presione Enter para continuar..."
                ;;

            5)
                read -r -p "Puerto para Dropbear [109]: " nuevo
                nuevo=${nuevo:-109}

                if [[ ! "$nuevo" =~ ^[0-9]+$ ]] || (( nuevo < 1 || nuevo > 65535 )); then
                    echo -e "${R}Puerto inválido.${N}"
                elif ! charly_dropbear_puerto_libre "$nuevo"; then
                    echo -e "${R}El puerto $nuevo está ocupado por otro servicio.${N}"
                else
                    respaldo=$(mktemp) || {
                        echo -e "${R}No se pudo crear respaldo.${N}"
                        read -r -p "Presione Enter..."
                        continue
                    }

                    export DEBIAN_FRONTEND=noninteractive

                    if ! apt-get update || ! apt-get install -y dropbear; then
                        echo -e "${R}Error instalando el paquete Dropbear.${N}"
                        rm -f "$respaldo"
                        read -r -p "Presione Enter para continuar..."
                        continue
                    fi

                    if ! command -v dropbear >/dev/null 2>&1; then
                        echo -e "${R}No se encontró el ejecutable Dropbear.${N}"
                        rm -f "$respaldo"
                        read -r -p "Presione Enter para continuar..."
                        continue
                    fi

                    cp -a /etc/default/dropbear "$respaldo"

                    install -d -m 755 /etc/dropbear

                    if [[ ! -s /etc/dropbear/dropbear_rsa_host_key ]]; then
                        dropbearkey -t rsa -f /etc/dropbear/dropbear_rsa_host_key >/dev/null 2>&1
                    fi

                    if [[ ! -s /etc/dropbear/dropbear_ed25519_host_key ]]; then
                        dropbearkey -t ed25519 -f /etc/dropbear/dropbear_ed25519_host_key >/dev/null 2>&1
                    fi

                    if [[ ! -s /etc/dropbear/dropbear_rsa_host_key ||
                          ! -s /etc/dropbear/dropbear_ed25519_host_key ]]; then
                        echo -e "${R}No se pudieron generar las claves SSH.${N}"
                        rm -f "$respaldo"
                        read -r -p "Presione Enter para continuar..."
                        continue
                    fi

                    if charly_dropbear_configurar "$nuevo" &&
                       systemctl enable dropbear &&
                       systemctl restart dropbear &&
                       charly_dropbear_verificar "$nuevo"; then
                        echo -e "${G}DROPBEAR instalado y verificado en el puerto $nuevo.${N}"
                        rm -f "$respaldo"
                    else
                        cp -a "$respaldo" /etc/default/dropbear
                        systemctl restart dropbear
                        echo -e "${R}La instalación no superó la verificación.${N}"
                        echo -e "${Y}Se restauró la configuración anterior.${N}"
                        journalctl -u dropbear -n 20 --no-pager
                        rm -f "$respaldo"
                    fi
                fi
                read -r -p "Presione Enter para continuar..."
                ;;

            6)
                read -r -p "¿Confirmas desinstalar Dropbear? [s/N]: " confirmar
                if [[ "$confirmar" =~ ^[sS]$ ]]; then
                    systemctl disable --now dropbear 2>/dev/null
                    if apt-get purge -y dropbear; then
                        echo -e "${G}Dropbear desinstalado correctamente.${N}"
                    else
                        echo -e "${R}No se pudo completar la desinstalación.${N}"
                    fi
                fi
                read -r -p "Presione Enter para continuar..."
                ;;

            0) return ;;
            *) echo -e "${R}Opción incorrecta.${N}"; sleep 1 ;;
        esac
    done
}


charly_badvpn_crear_servicio() {
    local puerto="$1"

    cat > /etc/systemd/system/badvpn.service <<EOF
[Unit]
Description=BADVPN UDP Gateway
After=network.target

[Service]
Type=simple
Restart=always
RestartSec=3
ExecStart=/usr/local/bin/badvpn-udpgw --loglevel warning --listen-addr 127.0.0.1:${puerto} --udp-mtu 9000 --max-clients 2000 --max-connections-for-client 100 --client-socket-sndbuf 1048576

[Install]
WantedBy=multi-user.target
EOF
    chmod 644 /etc/systemd/system/badvpn.service
    systemctl daemon-reload
}

charly_badvpn_puerto() {
    local p
    p=$(grep -oE -- '--listen-addr 127\.0\.0\.1:[0-9]+' \
        /etc/systemd/system/badvpn.service 2>/dev/null |
        head -1 | awk -F: '{print $NF}')
    echo "${p:-7300}"
}

charly_badvpn_puerto_libre() {
    local p="$1" ocupacion
    ocupacion=$(ss -H -lunp "sport = :$p" 2>/dev/null)
    [[ -z "$ocupacion" ]] && return 0
    grep -q 'badvpn-udpgw' <<< "$ocupacion"
}

charly_badvpn_instalar() {
    local puerto="$1" directorio="/usr/local/src/badvpn-charly"

    echo
    echo -e "${C}INSTALANDO BADVPN-UDPGW${N}"
    echo

    if ! apt-get update || ! apt-get install -y git cmake build-essential; then
        echo -e "${R}Error instalando las dependencias.${N}"
        return 1
    fi

    if [[ ! -d "$directorio/.git" ]]; then
        rm -rf "$directorio"
        if ! git clone --depth 1 https://github.com/ambrop72/badvpn.git "$directorio"; then
            echo -e "${R}No se pudo descargar el código original.${N}"
            return 1
        fi
    fi

    mkdir -p "$directorio/build"
    cd "$directorio/build" || return 1

    if ! cmake .. -DBUILD_NOTHING_BY_DEFAULT=1 -DBUILD_UDPGW=1; then
        echo -e "${R}Error configurando la compilación.${N}"
        return 1
    fi

    if ! make -j2; then
        echo -e "${R}Error compilando BADVPN.${N}"
        return 1
    fi

    if [[ ! -x udpgw/badvpn-udpgw ]]; then
        echo -e "${R}No se encontró el ejecutable compilado.${N}"
        return 1
    fi

    install -m 755 udpgw/badvpn-udpgw /usr/local/bin/badvpn-udpgw

    if ! charly_badvpn_crear_servicio "$puerto"; then
        echo -e "${R}No se pudo crear el servicio.${N}"
        return 1
    fi

    if systemctl enable badvpn && systemctl restart badvpn &&
       systemctl is-active --quiet badvpn; then
        echo
        echo -e "${G}BADVPN INSTALADO CORRECTAMENTE${N}"
        echo -e "${C}BINARIO:${N} /usr/local/bin/badvpn-udpgw"
        echo -e "${C}PUERTO:${N} 127.0.0.1:$puerto"
        return 0
    fi

    echo -e "${R}BADVPN fue compilado, pero el servicio no inició.${N}"
    journalctl -u badvpn -n 20 --no-pager
    return 1
}

menu_badvpn() {
    local op puerto nuevo confirmar respaldo binario estado

    while true; do
        clear

        binario=$(command -v badvpn-udpgw 2>/dev/null || true)
        puerto=$(charly_badvpn_puerto)

        if [[ -n "$binario" ]]; then
            binario_estado="Instalado"
        else
            binario="/usr/local/bin/badvpn-udpgw"
            binario_estado="No instalado"
        fi

        if systemctl is-active --quiet badvpn; then
            estado="${G}ON${N}"
        else
            estado="${R}OFF${N}"
        fi

        linea
        printf "             ${W}ADMINISTRADOR BADVPN-UDPGW${N}\n"
        linea
        printf " ${C}BINARIO:${N}    %s\n" "$binario_estado"
        printf " ${C}RUTA:${N}       %s\n" "$binario"
        printf " ${C}ESTADO:${N}     %b\n" "$estado"
        printf " ${C}ESCUCHA:${N}    127.0.0.1:%s\n" "$puerto"
        linea
        echo
        echo -e " ${C}[1]${N} Instalar / Reinstalar BADVPN"
        echo -e " ${C}[2]${N} Modificar puerto"
        echo -e " ${C}[3]${N} Iniciar servicio"
        echo -e " ${C}[4]${N} Detener servicio"
        echo -e " ${C}[5]${N} Reiniciar servicio"
        echo -e " ${C}[6]${N} Ver puertos activos"
        echo -e " ${C}[7]${N} Ver logs"
        echo -e " ${R}[8]${N} Desinstalar BADVPN"
        linea
        echo -e " ${R}[0]${N} Volver"
        linea
        echo
        read -r -p " Opción: " op

        case "$op" in
            1)
                if [[ -x "$binario" ]]; then
                    echo -e "${Y}BADVPN ya está instalado.${N}"
                    read -r -p "¿Reinstalar? [s/N]: " confirmar
                    [[ "$confirmar" =~ ^[sS]$ ]] || continue
                fi

                read -r -p "Puerto UDP [7300]: " nuevo
                nuevo=${nuevo:-7300}

                if [[ ! "$nuevo" =~ ^[0-9]+$ ]] ||
                   (( nuevo < 1 || nuevo > 65535 )); then
                    echo -e "${R}Puerto inválido.${N}"
                elif ! charly_badvpn_puerto_libre "$nuevo"; then
                    echo -e "${R}El puerto está ocupado por otro servicio.${N}"
                else
                    charly_badvpn_instalar "$nuevo"
                fi
                read -r -p "Presione Enter para continuar..."
                ;;

            2)
                if [[ ! -x "$binario" ]]; then
                    echo -e "${R}Primero instala BADVPN.${N}"
                else
                    read -r -p "Nuevo puerto UDP: " nuevo

                    if [[ ! "$nuevo" =~ ^[0-9]+$ ]] ||
                       (( nuevo < 1 || nuevo > 65535 )); then
                        echo -e "${R}Puerto inválido.${N}"
                    elif ! charly_badvpn_puerto_libre "$nuevo"; then
                        echo -e "${R}El puerto está ocupado.${N}"
                    else
                        respaldo=$(mktemp) || continue
                        cp -a /etc/systemd/system/badvpn.service "$respaldo"

                        if charly_badvpn_crear_servicio "$nuevo" &&
                           systemctl restart badvpn &&
                           systemctl is-active --quiet badvpn; then
                            echo -e "${G}Puerto cambiado a $nuevo correctamente.${N}"
                            rm -f "$respaldo"
                        else
                            cp -a "$respaldo" /etc/systemd/system/badvpn.service
                            systemctl daemon-reload
                            systemctl restart badvpn
                            rm -f "$respaldo"
                            echo -e "${R}Falló el cambio. Se restauró la configuración anterior.${N}"
                            journalctl -u badvpn -n 15 --no-pager
                        fi
                    fi
                fi
                read -r -p "Presione Enter para continuar..."
                ;;

            3)
                if [[ -x "$binario" ]]; then
                    systemctl start badvpn
                    systemctl status badvpn --no-pager -l
                else
                    echo -e "${R}BADVPN no está instalado.${N}"
                fi
                read -r -p "Presione Enter para continuar..."
                ;;

            4)
                systemctl stop badvpn
                echo -e "${Y}Servicio detenido.${N}"
                read -r -p "Presione Enter para continuar..."
                ;;

            5)
                systemctl restart badvpn
                systemctl status badvpn --no-pager -l
                read -r -p "Presione Enter para continuar..."
                ;;

            6)
                echo
                if systemctl is-active --quiet badvpn; then
                    puerto=$(charly_badvpn_puerto)
                    echo -e "${G}BADVPN ACTIVO${N}"
                    echo -e " ${C}Puerto configurado:${N} 127.0.0.1:${Y}${puerto}${N}"
                else
                    echo -e "${R}BADVPN NO ESTÁ ACTIVO${N}"
                    echo "No hay un puerto activo para BADVPN."
                fi
                echo
                read -r -p "Presione Enter para continuar..."
                ;;

            7)
                journalctl -u badvpn -b -n 40 --no-pager
                echo
                read -r -p "Presione Enter para continuar..."
                ;;

            8)
                read -r -p "¿Confirmas desinstalar BADVPN? [s/N]: " confirmar
                if [[ "$confirmar" =~ ^[sS]$ ]]; then
                    systemctl disable --now badvpn 2>/dev/null
                    rm -f /etc/systemd/system/badvpn.service
                    rm -f /usr/local/bin/badvpn-udpgw
                    rm -rf /usr/local/src/badvpn-charly
                    systemctl daemon-reload
                    echo -e "${G}BADVPN desinstalado.${N}"
                fi
                read -r -p "Presione Enter para continuar..."
                ;;

            0) return ;;
            *) echo -e "${R}Opción incorrecta.${N}"; sleep 1 ;;
        esac
    done
}



