charly_hcr_config() {
    mkdir -p /etc/charly/tls
    if [[ ! -f /etc/charly/hcr.conf ]]; then
        cat > /etc/charly/hcr.conf <<'EOF'
PUERTO=8080
SSH_PUERTO=22
MAX_DOWNLOAD_FRAME=1280
DOWNLOAD_POLL_TIMEOUT=5s
SSL_ENABLED=0
TLS_CERT=/etc/charly/tls/hcr.crt
TLS_KEY=/etc/charly/tls/hcr.key
MAX_SESSIONS=32
EOF
        chmod 600 /etc/charly/hcr.conf
    fi
    source /etc/charly/hcr.conf
}

charly_hcr_puerto_libre() {
    local p="$1" ocupado
    ocupado=$(ss -H -lntp "sport = :$p" 2>/dev/null)
    [[ -z "$ocupado" ]] && return 0
    grep -q 'HCR' <<< "$ocupado"
}

charly_hcr_crear_servicio() {
    local puerto="$1" ssh="$2" frame="$3" timeout="$4" transporte=plain tls_args=""
    source /etc/charly/hcr.conf
    if [[ "${SSL_ENABLED:-0}" == "1" ]]; then
        transporte=tls
        if [[ ! -s "$TLS_CERT" || ! -s "$TLS_KEY" ]]; then
            if ! openssl req -x509 -nodes -newkey rsa:2048 \
                -keyout "$TLS_KEY" -out "$TLS_CERT" -days 3650 \
                -subj "/CN=CHARLY-HCR"; then
                echo -e "${R}No se pudo generar el certificado TLS.${N}"
                return 1
            fi
            chmod 600 "$TLS_KEY"; chmod 644 "$TLS_CERT"
        fi
        tls_args="-tls-cert $TLS_CERT -tls-key $TLS_KEY"
    fi
    cat > /etc/systemd/system/hcr.service <<EOF
[Unit]
Description=CHARLY HCR Tunnel
After=network.target ssh.service
[Service]
Type=simple
ExecStart=/usr/local/bin/HCR -listen 0.0.0.0:${puerto} -target 127.0.0.1:${ssh} -max-download-frame ${frame} -download-poll-timeout ${timeout} -max-sessions ${MAX_SESSIONS:-32} -transport ${transporte} ${tls_args}
Restart=always
RestartSec=3
LimitNOFILE=65535
[Install]
WantedBy=multi-user.target
EOF
    chmod 644 /etc/systemd/system/hcr.service
    systemctl daemon-reload
}

charly_hcr_instalar() {
    local puerto="$1" ssh="$2" tmp
    echo -e "${C}INSTALANDO HCR${N}"
    tmp=$(mktemp) || return 1
    if ! charly_hcr_motor_embebido | base64 -d > "$tmp"; then rm -f "$tmp"; return 1; fi
    if [[ "$(sha256sum "$tmp" | awk '{print $1}')" != "68a66ed49750965680315a60ce05260cdbb77c2b86b3a80938844cb4855fa085" ]]; then
        rm -f "$tmp"; echo -e "${R}SHA256 incorrecto para el motor HCR.${N}"; return 1
    fi
    install -m 755 "$tmp" /usr/local/bin/HCR || { rm -f "$tmp"; return 1; }
    rm -f "$tmp"
    charly_hcr_config
    sed -i "s/^PUERTO=.*/PUERTO=${puerto}/; s/^SSH_PUERTO=.*/SSH_PUERTO=${ssh}/" /etc/charly/hcr.conf
    charly_hcr_config
    charly_hcr_crear_servicio "$PUERTO" "$SSH_PUERTO" "$MAX_DOWNLOAD_FRAME" "$DOWNLOAD_POLL_TIMEOUT" || return 1
    if systemctl enable hcr && systemctl restart hcr && systemctl is-active --quiet hcr; then
        echo -e "${G}HCR instalado y activo.${N}"; return 0
    fi
    journalctl -u hcr -n 20 --no-pager; return 1
}

charly_hcr_aplicar() {
    charly_hcr_crear_servicio "$PUERTO" "$SSH_PUERTO" "$MAX_DOWNLOAD_FRAME" "$DOWNLOAD_POLL_TIMEOUT" || return 1
    systemctl restart hcr && systemctl is-active --quiet hcr
}

charly_hcr_desinstalar() {
    systemctl disable --now hcr 2>/dev/null || true
    rm -f /etc/systemd/system/hcr.service /usr/local/bin/HCR /etc/charly/hcr.conf
    rm -f /etc/charly/tls/hcr.crt /etc/charly/tls/hcr.key
    systemctl daemon-reload
    echo -e "${G}HCR desinstalado. El motor incrustado en CHARLY se conserva.${N}"
}

menu_hcr() {
    local op estado nuevo confirmar
    charly_hcr_config
    if [[ ! -x /usr/local/bin/HCR ]]; then
        echo; echo -e "${Y}HCR todavía no está instalado.${N}"
        read -r -p "¿Instalar HCR con los valores predeterminados? [S/n]: " confirmar
        [[ "$confirmar" =~ ^[nN]$ ]] && return
        if ! charly_hcr_instalar "$PUERTO" "$SSH_PUERTO"; then read -r -p "Presione Enter para continuar..."; return; fi
    fi
    while true; do
        charly_hcr_config
        if systemctl is-active --quiet hcr; then estado="${G}ON${N}"; else estado="${R}OFF${N}"; fi
        clear; echo; linea
        printf "                 ${C}HCR TUNNEL${N}\n"
        linea
        echo -e "  ${B}[1]${N}> PUERTO HCR: ${Y}${PUERTO}${N}"
        echo -e "  ${B}[2]${N}> PUERTO DE REDIRECCION: ${Y}${SSH_PUERTO}${N}"
        echo -e "  ${B}[3]${N}> MAX DOWNLOAD FRAME: ${Y}${MAX_DOWNLOAD_FRAME}${N}"
        echo -e "  ${B}[4]${N}> DOWNLOAD POLL TIMEOUT: ${Y}${DOWNLOAD_POLL_TIMEOUT}${N}"
        if [[ "$SSL_ENABLED" == 1 ]]; then nuevo="${G}ON${N}"; else nuevo="${R}OFF${N}"; fi
        echo -e "  ${B}[5]${N}> MODO SSL/TLS [${nuevo}]"
        echo -e "  ${B}[6]${N}> ESTADO DEL SERVICIO [${estado}]"
        echo -e "  ${B}[7]${N}> REINICIAR SERVICIO"
        echo -e "  ${B}[8]${N}> INICIAR/PARAR SERVICIO [${estado}]"
        linea; echo -e "  ${R}[0] Volver${N}                         ${R}[9] DESINSTALAR${N}"; linea; echo
        read -r -p " Ingresa una Opción: " op
        case "$op" in
            1|2)
                if [[ "$op" == 1 ]]; then read -r -p "Nuevo puerto HCR [${PUERTO}]: " nuevo; else read -r -p "Nuevo puerto de redirección [${SSH_PUERTO}]: " nuevo; fi
                if [[ "$op" == 1 ]]; then nuevo=${nuevo:-$PUERTO}; else nuevo=${nuevo:-$SSH_PUERTO}; fi
                if [[ ! "$nuevo" =~ ^[0-9]+$ ]] || (( nuevo < 1 || nuevo > 65535 )); then echo -e "${R}Puerto inválido.${N}"
                elif [[ "$op" == 1 ]] && ! charly_hcr_puerto_libre "$nuevo"; then echo -e "${R}El puerto está ocupado.${N}"
                else
                    if [[ "$op" == 1 ]]; then sed -i "s/^PUERTO=.*/PUERTO=${nuevo}/" /etc/charly/hcr.conf; else sed -i "s/^SSH_PUERTO=.*/SSH_PUERTO=${nuevo}/" /etc/charly/hcr.conf; fi
                    charly_hcr_config; if charly_hcr_aplicar; then echo -e "${G}Configuración actualizada.${N}"; else echo -e "${R}No se pudo aplicar el cambio.${N}"; fi
                fi ;;
            3)
                read -r -p "MAX DOWNLOAD FRAME [${MAX_DOWNLOAD_FRAME}]: " nuevo; nuevo=${nuevo:-$MAX_DOWNLOAD_FRAME}
                if [[ "$nuevo" =~ ^[0-9]+$ ]] && (( nuevo >= 0 && nuevo <= 65535 )); then sed -i "s/^MAX_DOWNLOAD_FRAME=.*/MAX_DOWNLOAD_FRAME=${nuevo}/" /etc/charly/hcr.conf; charly_hcr_config; charly_hcr_aplicar && echo -e "${G}Frame actualizado.${N}" || echo -e "${R}No se pudo aplicar.${N}"; else echo -e "${R}Valor inválido.${N}"; fi ;;
            4)
                read -r -p "DOWNLOAD POLL TIMEOUT [${DOWNLOAD_POLL_TIMEOUT}]: " nuevo; nuevo=${nuevo:-$DOWNLOAD_POLL_TIMEOUT}
                if [[ "$nuevo" =~ ^[0-9]+(ms|s|m|h)$ ]]; then sed -i "s/^DOWNLOAD_POLL_TIMEOUT=.*/DOWNLOAD_POLL_TIMEOUT=${nuevo}/" /etc/charly/hcr.conf; charly_hcr_config; charly_hcr_aplicar && echo -e "${G}Timeout actualizado.${N}" || echo -e "${R}No se pudo aplicar.${N}"; else echo -e "${R}Formato inválido. Usa 500ms, 5s, 1m.${N}"; fi ;;
            5)
                if [[ "$SSL_ENABLED" == 1 ]]; then sed -i 's/^SSL_ENABLED=.*/SSL_ENABLED=0/' /etc/charly/hcr.conf; else sed -i 's/^SSL_ENABLED=.*/SSL_ENABLED=1/' /etc/charly/hcr.conf; fi
                charly_hcr_config; charly_hcr_aplicar && echo -e "${G}Modo SSL/TLS actualizado.${N}" || echo -e "${R}No se pudo aplicar SSL/TLS.${N}" ;;
            6) systemctl status hcr --no-pager; journalctl -u hcr -n 10 --no-pager ;;
            7) systemctl restart hcr && systemctl is-active --quiet hcr && echo -e "${G}HCR reiniciado.${N}" || journalctl -u hcr -n 20 --no-pager ;;
            8) if systemctl is-active --quiet hcr; then systemctl stop hcr; else systemctl start hcr; fi ;;
            9) read -r -p "¿Confirmas desinstalar HCR? [s/N]: " confirmar; if [[ "$confirmar" =~ ^[sS]$ ]]; then charly_hcr_desinstalar; return; fi ;;
            0) return ;;
            *) echo -e "${R}Opción incorrecta.${N}" ;;
        esac
        read -r -p "Presione Enter para continuar..."
    done
}
