# ===== CHARLY SLIPGATE INSTALLER FIX (official installer runs once) =====
charly_slipstream_instalar() {
    local tmp_gate tmp_stream rc
    echo -e "${C}INSTALADOR OFICIAL SLIPGATE + SLIPSTREAM${N}"

    # Si ya existe una instalación, no volver a instalar ni abrir asistentes.
    if [[ -x /usr/local/bin/slipgate && -e /etc/slipgate/config.json ]]; then
        echo -e "${Y}SlipGate ya está instalado. No se sobrescribirá la configuración.${N}"
        echo
        /usr/local/bin/slipgate tunnel status
        return $?
    fi

    # Restos sin una instalación completa: detenerse para no pisar datos existentes.
    if [[ -e /etc/slipgate || -e /etc/systemd/system/slipgate-dnsrouter.service || \
          -e /etc/systemd/system/slipgate-charly.service || -x /usr/local/bin/slipgate ]]; then
        echo -e "${R}Se detectaron archivos o servicios de SlipGate, pero no una instalación completa.${N}"
        echo "No se modificó ni eliminó ningún archivo. Revisa la instalación existente antes de continuar."
        return 1
    fi

    tmp_gate=$(mktemp) || return 1
    tmp_stream=$(mktemp) || { rm -f "$tmp_gate"; return 1; }
    if ! charly_slipgate_motor_embebido | base64 -d >"$tmp_gate" || \
       [[ "$(sha256sum "$tmp_gate" | awk '{print $1}')" != "$CHARLY_SLIPGATE_SHA" ]]; then
        rm -f "$tmp_gate" "$tmp_stream"
        echo -e "${R}No se pudo verificar el motor SlipGate integrado.${N}"
        return 1
    fi
    if ! charly_slipstream_motor_embebido | base64 -d >"$tmp_stream" || \
       [[ "$(sha256sum "$tmp_stream" | awk '{print $1}')" != "$CHARLY_SLIPSTREAM_SHA" ]]; then
        rm -f "$tmp_gate" "$tmp_stream"
        echo -e "${R}No se pudo verificar el motor Slipstream integrado.${N}"
        return 1
    fi

    if ! install -o root -g root -m 755 "$tmp_gate" /usr/local/bin/slipgate; then
        rm -f "$tmp_gate" "$tmp_stream"
        return 1
    fi
    if ! install -o root -g root -m 755 "$tmp_stream" /usr/local/bin/slipstream-server; then
        rm -f "$tmp_gate" "$tmp_stream"
        return 1
    fi
    rm -f "$tmp_gate" "$tmp_stream"

    echo -e "${G}Motores integrados verificados e instalados.${N}"
    echo "Iniciando el instalador oficial de SlipGate."
    echo "El instalador oficial gestiona la creación del túnel; CHARLY no abrirá un segundo asistente."
    /usr/local/bin/slipgate install
    rc=$?
    if (( rc != 0 )); then
        echo -e "${R}El instalador oficial devolvió error ($rc). No se ejecutará otro asistente ni se crearán configuraciones manuales.${N}"
        return "$rc"
    fi

    mkdir -p /etc/charly/slipstream
    printf 'INSTALLER=slipgate-official\n' > /etc/charly/slipstream/ownership
    chmod 600 /etc/charly/slipstream/ownership

    echo
    echo -e "${G}Instalador oficial finalizado. Estado de los túneles:${N}"
    /usr/local/bin/slipgate tunnel status
    rc=$?
    echo
    echo "Regresando al menú CHARLY. Para crear otro túnel, usa la opción 2 (Administrar túneles)."
    return "$rc"
}

