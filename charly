CHARLY_BHTTP_PAYLOAD
    [[ "$(sha256sum "$destino" | awk '{print $1}')" == "$CHARLY_BHTTP_SHA" ]]
}

charly_bhttp_config() {
    mkdir -p /etc/charly/tls
    if [[ ! -f /etc/charly/bhttp.conf ]]; then
        cat > /etc/charly/bhttp.conf <<EOF
PUERTO=80
SSH_PUERTO=22
LANES=128
TIMEOUT=5m
XHTTP_ENABLED=0
PUERTO_XHTTP=443
TLS_CERT=/etc/charly/tls/bhttp.crt
TLS_KEY=/etc/charly/tls/bhttp.key
EOF
        chmod 600 /etc/charly/bhttp.conf
    fi
    source /etc/charly/bhttp.conf
}

charly_bhttp_puerto_libre() {
    local p="$1" ocupado
    ocupado=$(ss -H -lntp "sport = :$p" 2>/dev/null)
    [[ -z "$ocupado" ]] && return 0
    grep -q 'bhttp-sn' <<< "$ocupado"
}

charly_bhttp_crear_servicio() {
    local puerto="$1" ssh="$2" lanes="$3" timeout="$4"
    local xhttp_args=""

    source /etc/charly/bhttp.conf

    if [[ "${XHTTP_ENABLED:-0}" == "1" ]]; then
        if [[ ! -s "$TLS_CERT" || ! -s "$TLS_KEY" ]]; then
            mkdir -p /etc/charly/tls
            if ! openssl req -x509 -nodes -newkey rsa:2048 \
                -keyout "$TLS_KEY" -out "$TLS_CERT" -days 3650 \
                -subj "/CN=CHARLY-BHTTP"; then
                echo -e "${R}No se pudo generar el certificado TLS.${N}"
                return 1
            fi
            chmod 600 "$TLS_KEY"
            chmod 644 "$TLS_CERT"
        fi

        xhttp_args="-xhttp-listen 0.0.0.0:${PUERTO_XHTTP} -tls-cert ${TLS_CERT} -tls-key ${TLS_KEY}"
    fi

    cat > /etc/systemd/system/bhttp-sn.service <<EOF
[Unit]
Description=CHARLY BHTTP-SN Bilola
After=network.target ssh.service

[Service]
Type=simple
ExecStart=/usr/local/bin/bhttp-sn -listen 0.0.0.0:${puerto} -target 127.0.0.1:${ssh} -session-timeout ${timeout} -bhttp-v2-max-lanes ${lanes} ${xhttp_args}
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
EOF
    chmod 644 /etc/systemd/system/bhttp-sn.service
    systemctl daemon-reload
}

charly_bhttp_instalar() {
    local puerto="$1" ssh="$2" archivo

    echo
    echo -e "${C}INSTALANDO BHTTP-SN${N}"

    archivo=$(mktemp) || return 1
    if ! charly_bhttp_motor_embebido "$archivo"; then
        rm -f "$archivo"
        echo -e "${R}El motor BHTTP-SN integrado no pasó la verificación SHA256.${N}"
        return 1
    fi

    if ! install -o root -g root -m 755 "$archivo" /usr/local/bin/bhttp-sn; then
        rm -f "$archivo"
        echo -e "${R}No se pudo instalar el motor BHTTP-SN.${N}"
        return 1
    fi
    rm -f "$archivo"

    cat > /etc/charly/bhttp.conf <<EOF
PUERTO=${puerto}
SSH_PUERTO=${ssh}
LANES=128
TIMEOUT=5m
XHTTP_ENABLED=0
PUERTO_XHTTP=443
TLS_CERT=/etc/charly/tls/bhttp.crt
TLS_KEY=/etc/charly/tls/bhttp.key
EOF
    chmod 600 /etc/charly/bhttp.conf

    charly_bhttp_crear_servicio "$puerto" "$ssh" 128 2m || return 1

    if systemctl enable bhttp-sn && systemctl restart bhttp-sn &&
       systemctl is-active --quiet bhttp-sn; then
        echo -e "${G}BHTTP-SN instalado y activo.${N}"
        echo -e "${C}Escucha:${N} 0.0.0.0:${puerto}"
        echo -e "${C}Destino:${N} 127.0.0.1:${ssh}"
        return 0
    fi

    echo -e "${R}El servicio no pudo iniciar.${N}"
    journalctl -u bhttp-sn -n 20 --no-pager
    return 1
}

charly_bhttp_desinstalar() {
    systemctl disable --now bhttp-sn 2>/dev/null
    rm -f /etc/systemd/system/bhttp-sn.service
    rm -f /usr/local/bin/bhttp-sn
    rm -f /etc/charly/bhttp.conf
    systemctl daemon-reload
    echo -e "${G}BHTTP-SN desinstalado.${N}"
}

menu_bhttp() {
    local op estado puerto ssh lanes timeout nuevo nuevo_ssh confirmar

    while true; do
        charly_bhttp_config
        puerto="$PUERTO"
        ssh="$SSH_PUERTO"
        lanes="$LANES"
        timeout="$TIMEOUT"
        xhttp="${XHTTP_ENABLED:-0}"
        xhttp_port="${PUERTO_XHTTP:-443}"

        clear
        if systemctl is-active --quiet bhttp-sn; then
            estado="${G}● ACTIVO${N}"
        elif [[ -x /usr/local/bin/bhttp-sn ]]; then
            estado="${R}● INACTIVO${N}"
        else
            estado="${R}● INACTIVO / NO INSTALADO${N}"
        fi

        echo
        printf "       ${W}CHARLY VPS - BHTTP-SN${N}\n"
        printf " ${C}Optimizado para Máxima Estabilidad y Streaming${N}\n"
        linea
        echo
        echo -e "  ${B}1.${N} 📥  Instalar BHTTP"
        echo -e "  ${B}2.${N} 🗑️  Desinstalar BHTTP"
        echo -e "  ${B}3.${N} 🔌  Cambiar Puerto"
        echo -e "  ${B}4.${N} ⚡  Editar Canales BHTTP v2"
        echo -e "  ${B}5.${N} ⏱️  Editar Tiempo de Espera"
        echo -e "  ${B}6.${N} ⚙️  Editar Puerto de Escucha y Conexión"
        echo -e "  ${B}7.${N} 🔐  Activar / Desactivar XHTTP SSL/TLS"
        echo -e "  ${B}8.${N} ↩️  Actualizar Estado"
        echo -e "  ${B}0.${N} ❌  Volver"
        echo
        printf " ${G}Estado del Servicio:${N} %b\n" "$estado"
        printf " ${C}Escucha:${N} %s  ${C}SSH destino:${N} %s\n" "$puerto" "$ssh"
        printf " ${C}Canales:${N} %s  ${C}Tiempo:${N} %s\n" "$lanes" "$timeout"
        linea
        echo
        read -r -p " Seleccione una opción [0-8]: " op

        case "$op" in
            1)
                read -r -p "Puerto de escucha [${puerto}]: " nuevo
                nuevo=${nuevo:-$puerto}
                read -r -p "Puerto SSH de destino [${ssh}]: " nuevo_ssh
                nuevo_ssh=${nuevo_ssh:-$ssh}

                if [[ ! "$nuevo" =~ ^[0-9]+$ ]] ||
                   (( nuevo < 1 || nuevo > 65535 )) ||
                   [[ ! "$nuevo_ssh" =~ ^[0-9]+$ ]] ||
                   (( nuevo_ssh < 1 || nuevo_ssh > 65535 )); then
                    echo -e "${R}Puerto inválido.${N}"
                elif ! charly_bhttp_puerto_libre "$nuevo"; then
                    echo -e "${R}El puerto de escucha está ocupado.${N}"
                else
                    charly_bhttp_instalar "$nuevo" "$nuevo_ssh"
                fi
                read -r -p "Presione Enter para continuar..."
                ;;

            2)
                read -r -p "¿Confirmas desinstalar BHTTP-SN? [s/N]: " confirmar
                if [[ "$confirmar" =~ ^[sS]$ ]]; then
                    charly_bhttp_desinstalar
                fi
                read -r -p "Presione Enter para continuar..."
                ;;

            3|6)
                if [[ ! -x /usr/local/bin/bhttp-sn ]]; then
                    echo -e "${R}Primero instala BHTTP-SN.${N}"
                else
                    nuevo="$puerto"
                    nuevo_ssh="$ssh"
                    if [[ "$op" == 3 ]]; then
                        read -r -p "Nuevo puerto de escucha: " nuevo
                    else
                        read -r -p "Nuevo puerto de escucha [${puerto}]: " nuevo
                        nuevo=${nuevo:-$puerto}
                        read -r -p "Nuevo puerto SSH [${ssh}]: " nuevo_ssh
                        nuevo_ssh=${nuevo_ssh:-$ssh}
                    fi

                    if [[ ! "$nuevo" =~ ^[0-9]+$ ]] ||
                       (( nuevo < 1 || nuevo > 65535 )) ||
                       [[ ! "$nuevo_ssh" =~ ^[0-9]+$ ]] ||
                       (( nuevo_ssh < 1 || nuevo_ssh > 65535 )); then
                        echo -e "${R}Puerto inválido.${N}"
                    elif ! charly_bhttp_puerto_libre "$nuevo"; then
                        echo -e "${R}El puerto está ocupado.${N}"
                    else
                        charly_bhttp_crear_servicio "$nuevo" "$nuevo_ssh" "$lanes" "$timeout"
                        if systemctl restart bhttp-sn && systemctl is-active --quiet bhttp-sn; then
                            sed -i "s/^PUERTO=.*/PUERTO=${nuevo}/; s/^SSH_PUERTO=.*/SSH_PUERTO=${nuevo_ssh}/" /etc/charly/bhttp.conf
                            echo -e "${G}Configuración actualizada.${N}"
                        else
                            echo -e "${R}No inició el servicio. Revisa los logs.${N}"
                            journalctl -u bhttp-sn -n 15 --no-pager
                        fi
                    fi
                fi
                read -r -p "Presione Enter para continuar..."
                ;;

            4)
                if [[ ! -x /usr/local/bin/bhttp-sn ]]; then
                    echo -e "${R}Primero instala BHTTP-SN.${N}"
                else
                    read -r -p "Máximo de canales BHTTP v2 [${lanes}]: " nuevo
                    nuevo=${nuevo:-$lanes}
                    if [[ "$nuevo" =~ ^[0-9]+$ ]] && (( nuevo >= 1 && nuevo <= 1024 )); then
                        charly_bhttp_crear_servicio "$puerto" "$ssh" "$nuevo" "$timeout"
                        if systemctl restart bhttp-sn && systemctl is-active --quiet bhttp-sn; then
                            sed -i "s/^LANES=.*/LANES=${nuevo}/" /etc/charly/bhttp.conf
                            echo -e "${G}Canales actualizados.${N}"
                        else
                            echo -e "${R}No se pudo aplicar el cambio.${N}"
                        fi
                    else
                        echo -e "${R}Valor inválido. Usa un número entre 1 y 1024.${N}"
                    fi
                fi
                read -r -p "Presione Enter para continuar..."
                ;;

            5)
                if [[ ! -x /usr/local/bin/bhttp-sn ]]; then
                    echo -e "${R}Primero instala BHTTP-SN.${N}"
                else
                    read -r -p "Nuevo tiempo de espera [${timeout}]: " nuevo
                    nuevo=${nuevo:-$timeout}

                    if [[ "$nuevo" =~ ^[1-9][0-9]*(s|m|h)$ ]]; then
                        charly_bhttp_crear_servicio "$puerto" "$ssh" "$lanes" "$nuevo"
                        if systemctl restart bhttp-sn && systemctl is-active --quiet bhttp-sn; then
                            sed -i "s/^TIMEOUT=.*/TIMEOUT=${nuevo}/" /etc/charly/bhttp.conf
                            echo -e "${G}Tiempo actualizado a ${nuevo}.${N}"
                        else
                            echo -e "${R}No se pudo aplicar el cambio.${N}"
                            journalctl -u bhttp-sn -n 15 --no-pager
                        fi
                    else
                        echo -e "${R}Formato inválido. Ejemplos: 30s, 2m, 5m, 1h.${N}"
                    fi
                fi
                read -r -p "Presione Enter para continuar..."
                ;;

            7)
                if [[ ! -x /usr/local/bin/bhttp-sn ]]; then
                    echo -e "${R}Primero instala BHTTP-SN.${N}"
                elif [[ "$xhttp" == "1" ]]; then
                    sed -i 's/^XHTTP_ENABLED=.*/XHTTP_ENABLED=0/' /etc/charly/bhttp.conf
                    charly_bhttp_config
                    if charly_bhttp_crear_servicio "$puerto" "$ssh" "$lanes" "$timeout" &&
                       systemctl restart bhttp-sn && systemctl is-active --quiet bhttp-sn; then
                        echo -e "${G}XHTTP SSL/TLS desactivado.${N}"
                    else
                        echo -e "${R}No se pudo aplicar el cambio.${N}"
                    fi
                else
                    read -r -p "Puerto XHTTP SSL/TLS [${xhttp_port}]: " nuevo
                    nuevo=${nuevo:-$xhttp_port}
                    if [[ ! "$nuevo" =~ ^[0-9]+$ ]] || (( nuevo < 1 || nuevo > 65535 )); then
                        echo -e "${R}Puerto inválido.${N}"
                    elif ! charly_bhttp_puerto_libre "$nuevo"; then
                        echo -e "${R}El puerto XHTTP está ocupado.${N}"
                    else
                        sed -i "s/^XHTTP_ENABLED=.*/XHTTP_ENABLED=1/; s/^PUERTO_XHTTP=.*/PUERTO_XHTTP=${nuevo}/" /etc/charly/bhttp.conf
                        charly_bhttp_config
                        if charly_bhttp_crear_servicio "$puerto" "$ssh" "$lanes" "$timeout" &&
                           systemctl restart bhttp-sn && systemctl is-active --quiet bhttp-sn; then
                            echo -e "${G}XHTTP SSL/TLS activado en el puerto ${nuevo}.${N}"
                        else
                            echo -e "${R}No se pudo activar XHTTP. Revisa los logs.${N}"
                            journalctl -u bhttp-sn -n 20 --no-pager
                        fi
                    fi
                fi
                read -r -p "Presione Enter para continuar..."
                ;;
            8) continue ;;
            0) return ;;
            *) echo -e "${R}Opción incorrecta.${N}"; sleep 1 ;;
        esac
    done
}


