charly_resumen_puertos() {
    local proto addr proc puerto nombre clave
    local tcp="" udp="" tcp_count=0 udp_count=0
    local -A vistos=()

    while IFS='|' read -r proto addr proc; do
        [[ -n "$addr" ]] || continue
        puerto="${addr##*:}"
        [[ "$puerto" =~ ^[0-9]+$ ]] || continue

        nombre="Proceso"
        if [[ "$proc" =~ users:\(\(\"([^\"]+)\" ]]; then
            nombre="${BASH_REMATCH[1]}"
        fi

        case "$nombre" in
            sshd) nombre="SSH" ;;
            dropbear) nombre="Dropbear" ;;
            badvpn-udpgw) nombre="BADVPN" ;;
            udp-custom) nombre="UDP-Custom" ;;
            nginx) nombre="NGINX" ;;
            xray) nombre="XRAY" ;;
            systemd-resolve) nombre="DNS" ;;
            python|python3) nombre="SOCKS" ;;
        esac

        clave="$proto|$nombre|$puerto"
        [[ ${vistos[$clave]+si} ]] && continue
        vistos[$clave]=1

        local item
        item="${G}${nombre}${N}: ${Y}${puerto}${N}"

        if [[ "$proto" == "tcp" ]]; then
            ((tcp_count++))
            if [[ -n "$tcp" ]]; then
                if (( (tcp_count - 1) % 3 == 0 )); then
                    tcp+=$'\\n      '
                else
                    tcp+="  ${B}|${N}  "
                fi
            fi
            tcp+="$item"
        elif [[ "$proto" == "udp" ]]; then
            ((udp_count++))
            if [[ -n "$udp" ]]; then
                if (( (udp_count - 1) % 3 == 0 )); then
                    udp+=$'\\n      '
                else
                    udp+="  ${B}|${N}  "
                fi
            fi
            udp+="$item"
        fi
    done < <(
        ss -H -lntup 2>/dev/null |
        awk '{
            if ($1=="tcp" && $2!="LISTEN") next
            if ($1=="udp" && $NF ~ /badvpn-udpgw/) next
            print $1 "|" $5 "|" $NF
        }'
    )

    echo
    printf " ${B}┌────────────────── PUERTOS EN USO DEL VPS ──────────────────┐${N}\n"
    printf " ${B}│${N} ${C}TCP${N}  »  %b\n" "${tcp:-${R}Ninguno detectado${N}}"
    printf " ${B}│${N} ${C}UDP${N}  »  %b\n" "${udp:-${R}Ninguno detectado${N}}"
    printf " ${B}└────────────────────────────────────────────────────────────┘${N}\n"
}


charly_info_vps() {
