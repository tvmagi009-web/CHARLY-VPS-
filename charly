charly_slipstream_config() {
    mkdir -p /etc/charly/slipstream/tls /etc/slipgate/tunnels/charly
    if [[ ! -f /etc/charly/slipstream/slipstream.conf ]]; then
        cat > /etc/charly/slipstream/slipstream.conf <<'EOF'
DOMAIN=
PUBLIC_ADDRESS=
DNS_PORT=53
SLIPSTREAM_PORT=5310
SSH_PORT=22
MAX_CONNECTIONS=256
IDLE_TIMEOUT=60
EOF
        chmod 600 /etc/charly/slipstream/slipstream.conf
    fi
    source /etc/charly/slipstream/slipstream.conf
}

charly_slipstream_validar_puerto() {
    local p="$1"
    [[ "$p" =~ ^[0-9]+$ ]] && (( p >= 1 && p <= 65535 )) || return 1
    ! ss -H -lntup "sport = :$p" 2>/dev/null | grep -q .
}

charly_slipstream_crear_config() {
    local domain="$1" public="$2" dnsport="$3" localport="$4" sshport="$5" bindip
    bindip=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}')
    if [[ -z "$bindip" ]]; then
        bindip=$(ip -4 -o addr show scope global | awk 'NR==1{split($4,a,"/"); print a[1]}')
    fi
    [[ -n "$bindip" ]] || { echo "ERROR: no se pudo detectar la IP de escucha."; return 1; }

    python3 - "$domain" "$public" "$dnsport" "$localport" "$sshport" "$bindip" <<'PYJSON'
import json,sys,os
D,P,dp,lp,sp,B=sys.argv[1:]
obj={
 "listen":{"address":f"{B}:{dp}"},
 "tunnels":[{"tag":"charly","transport":"slipstream","backend":"ssh","domain":D,"port":int(lp),"enabled":True,"slipstream":{"cert":"/etc/slipgate/tunnels/charly/cert.pem","key":"/etc/slipgate/tunnels/charly/key.pem"}}],
 "backends":[{"tag":"ssh","type":"ssh","address":f"127.0.0.1:{sp}"}],
 "route":{"mode":"single","active":"charly","default":"charly"},
 "public_address":P
}
os.makedirs('/etc/slipgate',exist_ok=True)
with open('/etc/slipgate/config.json','w') as f:
    json.dump(obj,f,indent=2)
    f.write('\n')
os.chmod('/etc/slipgate/config.json',0o600)
PYJSON
}

charly_slipstream_servicios() {
    local domain="$1" dnsport="$2" localport="$3" sshport="$4" maxconn="${MAX_CONNECTIONS:-256}" idle="${IDLE_TIMEOUT:-60}"
    cat > /etc/systemd/system/charly-slipstream.service <<EOF
[Unit]
Description=CHARLY Slipstream DNS Tunnel Server
After=network.target ssh.service
Wants=network-online.target
[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/slipstream-server --dns-listen-host 127.0.0.1 --dns-listen-port $localport --cert /etc/slipgate/tunnels/charly/cert.pem --key /etc/slipgate/tunnels/charly/key.pem --domain $domain --target-address 127.0.0.1:$sshport --max-connections $maxconn --idle-timeout-seconds $idle
Restart=always
RestartSec=3
LimitNOFILE=65535
[Install]
WantedBy=multi-user.target
EOF
    cat > /etc/systemd/system/charly-slipgate-dnsrouter.service <<EOF
[Unit]
Description=CHARLY SlipGate DNS Router
After=network.target charly-slipstream.service
Wants=charly-slipstream.service
[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/slipgate dnsrouter serve
Restart=always
RestartSec=5
LimitNOFILE=65535
[Install]
WantedBy=multi-user.target
EOF
    chmod 644 /etc/systemd/system/charly-slipstream.service /etc/systemd/system/charly-slipgate-dnsrouter.service
    systemctl daemon-reload
}

charly_slipstream_instalar() {
    local domain public dnsport localport sshport tmp1 tmp2
    echo -e "${C}INSTALANDO SLIPGATE + SLIPSTREAM CHARLY${N}"
    read -r -p "Dominio DNS del túnel (ej. s.tudominio.com): " domain
    if [[ ! "$domain" =~ ^([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z]{2,63}$ ]]; then
        echo -e "${R}Dominio inválido. Debe ser un nombre DNS completo.${N}"; return 1
    fi
    # SlipGate utiliza rutas globales propias (/etc/slipgate y /usr/local/bin).
    # Para no sobrescribir instalaciones ajenas, CHARLY exige un VPS sin SlipGate previo.
    if [[ -e /etc/slipgate || -e /usr/local/bin/slipgate || -e /usr/local/bin/slipstream-server || \
          -e /etc/systemd/system/slipgate-dnsrouter.service || -e /etc/systemd/system/slipgate-snplus.service || \
          -e /etc/systemd/system/charly-slipgate-dnsrouter.service || -e /etc/systemd/system/charly-slipstream.service ]]; then
        echo -e "${R}Se detectó una instalación o archivo SlipGate/Slipstream preexistente.${N}"
        echo -e "${Y}Por seguridad, CHARLY no sobrescribirá ni compartirá esos archivos.${N}"
        echo -e "${Y}Este módulo requiere un VPS sin SlipGate instalado previamente.${N}"
        return 1
    fi
    read -r -p "Dirección pública para clientes [${domain}]: " public; public=${public:-$domain}
    if [[ ! "$public" =~ ^([A-Za-z0-9.-]+)$ ]]; then echo -e "${R}Dirección pública inválida.${N}"; return 1; fi
    read -r -p "Puerto DNS público [53]: " dnsport; dnsport=${dnsport:-53}
    read -r -p "Puerto local Slipstream [5310]: " localport; localport=${localport:-5310}
    read -r -p "Puerto SSH de destino [22]: " sshport; sshport=${sshport:-22}
    for p in "$dnsport" "$localport" "$sshport"; do
        if [[ ! "$p" =~ ^[0-9]+$ ]] || (( p < 1 || p > 65535 )); then echo -e "${R}Puerto inválido: $p${N}"; return 1; fi
    done
    if ! getent group slipgate >/dev/null 2>&1; then groupadd --system slipgate || return 1; fi
    tmp1=$(mktemp) || return 1; tmp2=$(mktemp) || { rm -f "$tmp1"; return 1; }
    if ! charly_slipgate_motor_embebido | base64 -d > "$tmp1" || [[ "$(sha256sum "$tmp1" | awk '{print $1}')" != "$CHARLY_SLIPGATE_SHA" ]]; then
        rm -f "$tmp1" "$tmp2"; echo -e "${R}SHA256 incorrecto para SlipGate.${N}"; return 1
    fi
    if ! charly_slipstream_motor_embebido | base64 -d > "$tmp2" || [[ "$(sha256sum "$tmp2" | awk '{print $1}')" != "$CHARLY_SLIPSTREAM_SHA" ]]; then
        rm -f "$tmp1" "$tmp2"; echo -e "${R}SHA256 incorrecto para Slipstream.${N}"; return 1
    fi
    install -m 755 "$tmp1" /usr/local/bin/slipgate || { rm -f "$tmp1" "$tmp2"; return 1; }
    install -m 755 "$tmp2" /usr/local/bin/slipstream-server || { rm -f "$tmp1" "$tmp2"; return 1; }
    rm -f "$tmp1" "$tmp2"
    mkdir -p /etc/slipgate/tunnels/charly /etc/charly/slipstream/tls
    if ! openssl req -x509 -nodes -newkey rsa:2048 -keyout /etc/slipgate/tunnels/charly/key.pem -out /etc/slipgate/tunnels/charly/cert.pem -days 825 -subj "/CN=$domain" -addext "subjectAltName=DNS:$domain" >/dev/null 2>&1; then
        echo -e "${R}No se pudo generar el certificado de Slipstream.${N}"; return 1
    fi
    chmod 600 /etc/slipgate/tunnels/charly/key.pem; chmod 644 /etc/slipgate/tunnels/charly/cert.pem
    charly_slipstream_crear_config "$domain" "$public" "$dnsport" "$localport" "$sshport" || return 1
    cat > /etc/charly/slipstream/slipstream.conf <<EOF
DOMAIN=$domain
PUBLIC_ADDRESS=$public
DNS_PORT=$dnsport
SLIPSTREAM_PORT=$localport
SSH_PORT=$sshport
MAX_CONNECTIONS=256
IDLE_TIMEOUT=60
EOF
    chmod 600 /etc/charly/slipstream/slipstream.conf
    source /etc/charly/slipstream/slipstream.conf
    charly_slipstream_servicios "$domain" "$dnsport" "$localport" "$sshport" || return 1
    if systemctl enable charly-slipstream charly-slipgate-dnsrouter && systemctl restart charly-slipstream && systemctl restart charly-slipgate-dnsrouter; then
        if systemctl is-active --quiet charly-slipstream && systemctl is-active --quiet charly-slipgate-dnsrouter; then
            mkdir -p /etc/charly/slipstream
            printf '%s\n' 'CHARLY_SLIPGATE_OWNED=1' > /etc/charly/slipstream/ownership
            chmod 600 /etc/charly/slipstream/ownership
            echo -e "${G}SlipGate y Slipstream CHARLY instalados y activos.${N}"
            echo -e "Dominio: $domain | DNS público: puerto $dnsport | Slipstream local: $localport | SSH: $sshport"
            return 0
        fi
    fi
    echo -e "${R}La instalación terminó, pero algún servicio no inició. Revisa el estado y los logs.${N}"
    journalctl -u charly-slipstream -u charly-slipgate-dnsrouter -n 30 --no-pager
    return 1
}

charly_slipstream_aplicar() {
    source /etc/charly/slipstream/slipstream.conf || return 1
    charly_slipstream_crear_config "$DOMAIN" "$PUBLIC_ADDRESS" "$DNS_PORT" "$SLIPSTREAM_PORT" "$SSH_PORT" || return 1
    charly_slipstream_servicios "$DOMAIN" "$DNS_PORT" "$SLIPSTREAM_PORT" "$SSH_PORT" || return 1
    systemctl restart charly-slipstream charly-slipgate-dnsrouter
}

charly_slipstream_desinstalar() {
    if [[ ! -f /etc/charly/slipstream/ownership ]] ||
       ! grep -qx 'CHARLY_SLIPGATE_OWNED=1' /etc/charly/slipstream/ownership; then
        echo "No se reconoce la propiedad de CHARLY. Cancelado."
        return 1
    fi

    if ! charly_slipstream_config_segura; then
        echo "La configuración global contiene otros túneles o fue modificada."
        echo "No se eliminará ningún archivo."
        return 1
    fi

    echo "Se eliminarán solamente los servicios y archivos propios de CHARLY."
    systemctl disable --now charly-slipgate-dnsrouter charly-slipstream 2>/dev/null || true

    rm -f /etc/systemd/system/charly-slipgate-dnsrouter.service
    rm -f /etc/systemd/system/charly-slipstream.service

    rm -f /etc/slipgate/tunnels/charly/cert.pem
    rm -f /etc/slipgate/tunnels/charly/key.pem
    rmdir /etc/slipgate/tunnels/charly 2>/dev/null || true

    rm -f /etc/slipgate/config.json
    rm -rf /etc/charly/slipstream

    systemctl daemon-reload
    echo "CHARLY SlipGate/Slipstream desinstalado."
    echo "Los motores globales se conservaron en /usr/local/bin."
}


charly_slipstream_owned() {
    local execstart
    [[ -x /usr/local/bin/slipgate ]] || return 1
    [[ -x /usr/local/bin/slipstream-server ]] || return 1
    [[ -f /etc/slipgate/tunnels/charly/cert.pem ]] || return 1
    [[ -f /etc/slipgate/tunnels/charly/key.pem ]] || return 1
    [[ -f /etc/charly/slipstream/slipstream.conf ]] || return 1

    execstart=$(systemctl show slipgate-charly.service \
        -p ExecStart --value 2>/dev/null) || return 1

    [[ "$execstart" == *"/usr/local/bin/slipstream-server"* ]] &&
    [[ "$execstart" == *"/etc/slipgate/tunnels/charly/cert.pem"* ]] &&
    [[ "$execstart" == *"/etc/slipgate/tunnels/charly/key.pem"* ]]
}

charly_slipstream_config_segura() {
    python3 - <<'PYJSON'
import json,sys
try:
    with open('/etc/slipgate/config.json') as f:
        c=json.load(f)
    tunnels=c.get('tunnels',[])
    if len(tunnels)!=1 or tunnels[0].get('tag')!='charly':
        sys.exit(1)
    if tunnels[0].get('transport')!='slipstream':
        sys.exit(1)
except Exception:
    sys.exit(1)
PYJSON
}

charly_slipstream_cambiar_dominio() {
    local nuevo publico respaldo certtmp keytmp
    source /etc/charly/slipstream/slipstream.conf || return 1

    read -r -p "Nuevo dominio DNS: " nuevo
    [[ "$nuevo" =~ ^([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z]{2,63}$ ]] || {
        echo "Dominio inválido."; return 1;
    }

    read -r -p "Dirección pública [$nuevo]: " publico
    publico=${publico:-$nuevo}
    [[ "$publico" =~ ^[A-Za-z0-9.-]+$ ]] || {
        echo "Dirección pública inválida."; return 1;
    }

    respaldo=$(mktemp -d) || return 1
    cp -a /etc/charly/slipstream/slipstream.conf "$respaldo/"
    cp -a /etc/slipgate/tunnels/charly "$respaldo/"

    certtmp=$(mktemp)
    keytmp=$(mktemp)

    if ! openssl req -x509 -nodes -newkey rsa:2048 \
        -keyout "$keytmp" -out "$certtmp" -days 825 \
        -subj "/CN=$nuevo" \
        -addext "subjectAltName=DNS:$nuevo" >/dev/null 2>&1; then
        rm -rf "$respaldo" "$certtmp" "$keytmp"
        echo "Error generando certificado."
        return 1
    fi

    if ! python3 - "$nuevo" "$publico" <<'PYCONF'
import sys
p='/etc/charly/slipstream/slipstream.conf'
d,pub=sys.argv[1:]
lines=open(p).read().splitlines()
values={'DOMAIN':d,'PUBLIC_ADDRESS':pub}
seen=set()
out=[]
for line in lines:
    key=line.split('=',1)[0] if '=' in line else ''
    if key in values:
        out.append(key+'='+values[key])
        seen.add(key)
    else:
        out.append(line)
for k,v in values.items():
    if k not in seen:
        out.append(k+'='+v)
open(p,'w').write('\n'.join(out)+'\n')
PYCONF
    then
        rm -rf "$respaldo" "$certtmp" "$keytmp"
        return 1
    fi

    install -m 600 "$keytmp" /etc/slipgate/tunnels/charly/key.pem
    install -m 644 "$certtmp" /etc/slipgate/tunnels/charly/cert.pem
    rm -f "$certtmp" "$keytmp"

    if charly_slipstream_aplicar; then
        echo "Dominio actualizado correctamente."
        rm -rf "$respaldo"
        return 0
    fi

    cp -a "$respaldo/slipstream.conf" /etc/charly/slipstream/
    rm -rf /etc/slipgate/tunnels/charly
    cp -a "$respaldo/charly" /etc/slipgate/tunnels/
    charly_slipstream_aplicar
    rm -rf "$respaldo"
    echo "No se pudo aplicar el cambio. Se restauró la configuración anterior."
    return 1
}

charly_slipstream_reinstalar_motor() {
    local tmp old
    charly_slipstream_owned || {
        echo "Instalación no reconocida como propiedad de CHARLY."
        return 1
    }
    charly_slipstream_config_segura || {
        echo "Configuración global modificada o con otros túneles. Operación cancelada."
        return 1
    }

    tmp=$(mktemp) || return 1
    old=$(mktemp) || { rm -f "$tmp"; return 1; }

    if ! charly_slipstream_motor_embebido | base64 -d > "$tmp" ||
       [[ "$(sha256sum "$tmp" | awk '{print $1}')" != "$CHARLY_SLIPSTREAM_SHA" ]]; then
        rm -f "$tmp" "$old"
        echo "Error verificando el motor integrado."
        return 1
    fi

    cp -a /usr/local/bin/slipstream-server "$old"
    install -m 755 "$tmp" /usr/local/bin/slipstream-server
    rm -f "$tmp"

    if charly_slipstream_aplicar; then
        echo "Motor Slipstream reinstalado."
        rm -f "$old"
        return 0
    fi

    install -m 755 "$old" /usr/local/bin/slipstream-server
    rm -f "$old"
    echo "Error. Se restauró el motor anterior."
    return 1
}

charly_slipstream_actualizar_motor() {
    charly_slipstream_owned || {
        echo "Instalación CHARLY no verificada."
        return 1
    }
    charly_slipstream_config_segura || {
        echo "Se detectaron otros túneles o cambios externos. Actualización cancelada."
        return 1
    }

    local respaldo
    respaldo=$(mktemp -d) || return 1
    cp -a /etc/slipgate/config.json "$respaldo/"
    cp -a /etc/charly/slipstream/slipstream.conf "$respaldo/"

    echo "Actualizando motor SlipGate..."
    if /usr/local/bin/slipgate update; then
        charly_slipstream_aplicar
        rm -rf "$respaldo"
        return $?
    fi

    echo "La actualización no terminó correctamente."
    rm -rf "$respaldo"
    return 1
}

menu_slipstream() {
    local op estado dns_estado

    while true; do
