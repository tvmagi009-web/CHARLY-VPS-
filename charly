charly_actualizar_script() {
    local url tmp nuevo backup
    url="https://raw.githubusercontent.com/tvmagi009-web/CHARLY-VPS-/main/charly"

    echo
    echo "Verificando conexión con GitHub..."
    command -v curl >/dev/null 2>&1 || {
        echo "ERROR: curl no está instalado."
        return 1
    }

    tmp=$(mktemp) || return 1
    nuevo="/usr/local/bin/charly.nuevo"

    if ! curl -fL --connect-timeout 10 --max-time 120 "$url" -o "$tmp"; then
        echo "ERROR: no se pudo descargar el script."
        rm -f "$tmp"
        return 1
    fi

    if [[ ! -s "$tmp" ]] || ! bash -n "$tmp" ||
       ! grep -q '^menu_principal()' "$tmp"; then
        echo "ERROR: el archivo descargado no es un CHARLY válido."
        rm -f "$tmp"
        return 1
    fi

    backup="/usr/local/bin/charly.backup.$(date +%Y%m%d_%H%M%S)"
    cp -a /usr/local/bin/charly "$backup" || {
        echo "ERROR: no se pudo crear la copia de seguridad."
        rm -f "$tmp"
        return 1
    }

    if ! install -o root -g root -m 755 "$tmp" "$nuevo"; then
        rm -f "$tmp" "$nuevo"
        return 1
    fi

    rm -f "$tmp"
    if mv -f "$nuevo" /usr/local/bin/charly; then
        echo "CHARLY actualizado correctamente."
        echo "Copia anterior: $backup"
        echo "Reinicia el menú para cargar la nueva versión."
        exit 0
    else
        echo "ERROR: no se pudo instalar la actualización."
        rm -f "$nuevo"
        return 1
    fi
}

